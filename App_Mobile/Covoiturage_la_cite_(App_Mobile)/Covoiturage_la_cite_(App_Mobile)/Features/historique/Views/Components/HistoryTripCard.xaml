<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/historique/Views/Components/HistoryTripCard.xaml
  BindingContext : HistoriqueCardDisplayModel
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.historique.Views.Components.HistoryTripCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.historique.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:HistoriqueCardDisplayModel">

    <Border BackgroundColor="White" StrokeThickness="0" Margin="12,6">
        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="6" Opacity="1"/></Border.Shadow>

        <VerticalStackLayout Spacing="0">

            <!-- ── En-tête : route + statut ────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto" Padding="16,14,16,10" ColumnSpacing="8">

                <VerticalStackLayout Grid.Column="0" Spacing="4">

                    <!-- Date -->
                    <Label Text="{Binding DateTimeLabel}"
                           FontSize="11" TextColor="#9CA3AF"
                           FontFamily="OpenSansRegular"/>

                    <!-- Route -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding Route.FromLabel}"
                               FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#0D1624" FontAttributes="Bold"/>
                        <Label Text="→" FontSize="14" TextColor="#7A879A"/>
                        <Label Text="{Binding Route.ToLabel}"
                               FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#0D1624" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <!-- Autre personne -->
                    <HorizontalStackLayout Spacing="6">
                        <Frame WidthRequest="22" HeightRequest="22" CornerRadius="11"
                               Padding="0" BackgroundColor="#EEF0F5"
                               BorderColor="Transparent" HasShadow="False">
                            <Label Text="{Binding OtherPersonInitial}"
                                   FontSize="9" TextColor="#08316e"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <Label Text="{Binding OtherPersonName}"
                               FontSize="12" TextColor="#4B5563"/>
                        <Label Text="{Binding OtherPersonRating, StringFormat='★ {0:N1}'}"
                               FontSize="12" TextColor="#D97706"
                               IsVisible="{Binding OtherPersonRating, Converter={StaticResource NotNullToBool}}"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>

                <!-- Statut badge -->
                <Border Grid.Column="1" Padding="8,4" StrokeThickness="0"
                        VerticalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.BackgroundColor>
                        <Binding Path="StatusColorHex" Converter="{StaticResource HexToColor}"/>
                    </Border.BackgroundColor>
                    <Label Text="{Binding StatusLabel}"
                           FontSize="11" FontFamily="OpenSansSemibold"
                           TextColor="White"/>
                </Border>

            </Grid>

            <!-- ── Infos trajet ──────────────────────────────────────────── -->
            <HorizontalStackLayout Spacing="16" Padding="16,0,16,12">
                <HorizontalStackLayout Spacing="4"
                    IsVisible="{Binding PriceLabel, Converter={StaticResource NotNullToBool}}">
                    <Label Text="💳" FontSize="12"/>
                    <Label Text="{Binding PriceLabel}"
                           FontSize="12" TextColor="#374151"
                           FontFamily="OpenSansSemibold"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4"
                    IsVisible="{Binding Co2Label, Converter={StaticResource NotNullToBool}}">
                    <Label Text="🌿" FontSize="12"/>
                    <Label Text="{Binding Co2Label}"
                           FontSize="12" TextColor="#374151"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!-- ── Note reçue (si disponible) ───────────────────────────── -->
            <Grid IsVisible="{Binding MyRatingReceived, Converter={StaticResource NotNullToBool}}"
                  BackgroundColor="#F9FAFB" Padding="16,10" ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="Votre note reçue" FontSize="12" TextColor="#6B7280"/>
                    <Label FontSize="13" TextColor="#D97706" FontFamily="OpenSansSemibold">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="MyRatingReceived" Converter="{StaticResource StarRatingConverter}"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
                <Label Grid.Column="1"
                       Text="{Binding RatingSourceLabel}"
                       FontSize="11" TextColor="#9CA3AF"/>
            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>
