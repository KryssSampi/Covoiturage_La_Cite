<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/finances/Views/Components/FinanceResumeView.xaml
  BindingContext : FinanceResumeDisplayModel
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.finances.Views.Components.FinanceResumeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.finances.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:FinanceResumeDisplayModel">

    <VerticalStackLayout Spacing="0">
        <Grid Padding="16,18,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="📅" FontSize="14" VerticalOptions="Center"/>
                <Label Text="Résumé financier" FontFamily="OpenSansSemibold" FontSize="14"
                       FontAttributes="Bold" TextColor="#0D1624" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
               Padding="0" Margin="16,0" HasShadow="True">
            <VerticalStackLayout Spacing="0">

                <!-- Grille 2×2 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="14" Spacing="3">
                        <Label Text="Gain mensuel" FontSize="11" TextColor="#7A879A"/>
                        <Label Text="{Binding MonthlyGain, StringFormat='{0:N2} $'}"
                               FontFamily="OpenSansSemibold" FontSize="18"
                               FontAttributes="Bold" TextColor="#1D9E75"/>
                        <Label Text="{Binding InsightText}" FontSize="11" TextColor="#7A879A"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                    <BoxView Grid.Row="0" Grid.Column="0" WidthRequest="1"
                             BackgroundColor="#12000000" HorizontalOptions="End"/>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Padding="14" Spacing="3">
                        <Label Text="Gain semaine" FontSize="11" TextColor="#7A879A"/>
                        <Label Text="{Binding WeeklyGain, StringFormat='{0:N2} $'}"
                               FontFamily="OpenSansSemibold" FontSize="18"
                               FontAttributes="Bold" TextColor="#1A56CC"/>
                        <Label Text="{Binding WeekLabel}" FontSize="11" TextColor="#7A879A"/>
                    </VerticalStackLayout>

                    <BoxView Grid.Row="0" Grid.ColumnSpan="2" HeightRequest="1"
                             BackgroundColor="#12000000" VerticalOptions="End"/>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Padding="14" Spacing="3">
                        <Label Text="{Binding CommissionPct, StringFormat='Commission ({0:P0})'}"
                               FontSize="11" TextColor="#7A879A"/>
                        <Label Text="{Binding Commission, StringFormat='{0:N2} $'}"
                               FontFamily="OpenSansSemibold" FontSize="18"
                               FontAttributes="Bold" TextColor="#BA7517"/>
                        <Label Text="Plateforme" FontSize="11" TextColor="#7A879A"/>
                    </VerticalStackLayout>
                    <BoxView Grid.Row="1" Grid.Column="0" WidthRequest="1"
                             BackgroundColor="#12000000" HorizontalOptions="End"/>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="14" Spacing="3">
                        <Label Text="Trajets payants" FontSize="11" TextColor="#7A879A"/>
                        <Label Text="{Binding PaidTrips}"
                               FontFamily="OpenSansSemibold" FontSize="18"
                               FontAttributes="Bold" TextColor="#1A56CC"/>
                        <Label Text="{Binding TotalTrips, StringFormat='sur {0} complétés'}"
                               FontSize="11" TextColor="#7A879A"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Barres de progression -->
                <BoxView HeightRequest="1" BackgroundColor="#12000000"/>
                <VerticalStackLayout Padding="16,14" Spacing="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Revenus bruts" FontSize="12" TextColor="#3D4A5C"/>
                        <Label Grid.Column="1"
                               Text="{Binding GrossRevenue, StringFormat='{0:N2} $'}"
                               FontAttributes="Bold" TextColor="#1D9E75" FontSize="12"/>
                    </Grid>
                    <Grid HeightRequest="5">
                        <BoxView CornerRadius="3" BackgroundColor="#EEF0F5" HorizontalOptions="Fill"/>
                        <BoxView CornerRadius="3" BackgroundColor="#1D9E75" HorizontalOptions="Start"
                                 WidthRequest="{Binding GrossPercent,
                                     Converter={StaticResource RatioToWidth},
                                     ConverterParameter='300'}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Revenus nets" FontSize="12" TextColor="#3D4A5C"/>
                        <Label Grid.Column="1"
                               Text="{Binding NetRevenue, StringFormat='{0:N2} $'}"
                               FontAttributes="Bold" TextColor="#1A56CC" FontSize="12"/>
                    </Grid>
                    <Grid HeightRequest="5">
                        <BoxView CornerRadius="3" BackgroundColor="#EEF0F5" HorizontalOptions="Fill"/>
                        <BoxView CornerRadius="3" BackgroundColor="#1A56CC" HorizontalOptions="Start"
                                 WidthRequest="{Binding NetPercent,
                                     Converter={StaticResource RatioToWidth},
                                     ConverterParameter='300'}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Objectif mensuel" FontSize="12" TextColor="#3D4A5C"/>
                        <Label Grid.Column="1" FontAttributes="Bold" TextColor="#BA7517" FontSize="12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding NetRevenue, StringFormat='{0:N2}'}"/>
                                    <Span Text=" $ / "/>
                                    <Span Text="{Binding MonthlyGoal, StringFormat='{0:N0} $'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                    <Grid HeightRequest="5">
                        <BoxView CornerRadius="3" BackgroundColor="#EEF0F5" HorizontalOptions="Fill"/>
                        <BoxView CornerRadius="3" BackgroundColor="#BA7517" HorizontalOptions="Start"
                                 WidthRequest="{Binding GoalPercent,
                                     Converter={StaticResource RatioToWidth},
                                     ConverterParameter='300'}"/>
                    </Grid>

                    <Frame BackgroundColor="#E1F5EE" CornerRadius="10"
                           BorderColor="Transparent" Padding="8" HasShadow="False">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📈" FontSize="13"/>
                            <Label Text="{Binding InsightText}"
                                   FontSize="12" TextColor="#0F6E56"
                                   LineBreakMode="WordWrap" HorizontalOptions="Fill"/>
                        </HorizontalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentView>
