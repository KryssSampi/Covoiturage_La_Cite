<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/favoris/Views/Components/FavoritePlaceCard.xaml
  Carte lieu favori — BindingContext : FavoriteCardDisplayModel (Type=Place)
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.favoris.Views.Components.FavoritePlaceCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.favoris.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:FavoriteCardDisplayModel">

    <Border BackgroundColor="White" StrokeThickness="1"
            Margin="12,5">
        <Border.Stroke><SolidColorBrush Color="#12000000"/></Border.Stroke>
        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#0A000000" Offset="0,1" Radius="4" Opacity="1"/></Border.Shadow>

        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="14,13">

            <!-- Icône lieu -->
            <Frame Grid.Column="0"
                   WidthRequest="44" HeightRequest="44" CornerRadius="10"
                   Padding="0" BackgroundColor="#EEF3FB"
                   BorderColor="Transparent" HasShadow="False"
                   VerticalOptions="Center">
                <Label Text="{Binding Emoji}" FontSize="20"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Frame>

            <!-- Infos -->
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       FontFamily="OpenSansSemibold" FontSize="14"
                       TextColor="#0D1624" FontAttributes="Bold"/>
                <Label Text="{Binding PlaceAddress}"
                       FontSize="12" TextColor="#7A879A"
                       LineBreakMode="TailTruncation"/>
                <HorizontalStackLayout Spacing="4"
                    IsVisible="{Binding PlaceEstimatedTime, Converter={StaticResource NotNullToBool}}">
                    <Border BackgroundColor="#F8F9FC" Padding="7,2" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="99"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="3">
                            <Label Text="🕐" FontSize="10"/>
                            <Label Text="{Binding PlaceEstimatedTime}"
                                   FontSize="11" TextColor="#7A879A" FontFamily="OpenSansSemibold"/>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Supprimer -->
            <Label Grid.Column="2" Text="✕"
                   FontSize="14" TextColor="#8A95A8"
                   VerticalOptions="Start"
                   Padding="4">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDeleteTapped"/>
                </Label.GestureRecognizers>
            </Label>

        </Grid>
    </Border>
</ContentView>
