<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Covoiturage_la_cite__App_Mobile_.Features.profile.Views.Settings.TripAmbianceTabView">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label x:Name="DescriptionLabel" TextColor="#7A879A" FontSize="13"/>

            <!-- Parler -->
            <Border Stroke="#E8ECF3" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Padding="16" Spacing="12">
                    <Label x:Name="TalkLabel" VerticalOptions="Center" FontSize="15" TextColor="#0D1624" HorizontalOptions="FillAndExpand"/>
                    <Switch x:Name="TalkSwitch" IsToggled="{Binding CanTalk}" Toggled="OnTalkToggled"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Musique -->
            <Border Stroke="#E8ECF3" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Padding="16" Spacing="12">
                    <Label x:Name="MusicLabel" VerticalOptions="Center" FontSize="15" TextColor="#0D1624" HorizontalOptions="FillAndExpand"/>
                    <Switch IsToggled="{Binding MusicAccepted}" Toggled="OnMusicToggled"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Animaux -->
            <Border Stroke="#E8ECF3" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Padding="16" Spacing="12">
                    <Label x:Name="PetsLabel" VerticalOptions="Center" FontSize="15" TextColor="#0D1624" HorizontalOptions="FillAndExpand"/>
                    <Switch IsToggled="{Binding PetsAccepted}" Toggled="OnPetsToggled"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Fumer -->
            <Border Stroke="#E8ECF3" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Padding="16" Spacing="12">
                    <Label x:Name="SmokeLabel" VerticalOptions="Center" FontSize="15" TextColor="#0D1624" HorizontalOptions="FillAndExpand"/>
                    <Switch IsToggled="{Binding SmokingAccepted}" Toggled="OnSmokeToggled"/>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
