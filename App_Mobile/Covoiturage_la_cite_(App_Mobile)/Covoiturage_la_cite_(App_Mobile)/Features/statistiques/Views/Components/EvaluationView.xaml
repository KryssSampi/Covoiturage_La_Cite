<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/statistiques/Views/Components/EvaluationView.xaml
  BindingContext : EvaluationSectionDisplayModel
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.statistiques.Views.Components.EvaluationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.statistiques.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:EvaluationSectionDisplayModel">

    <VerticalStackLayout Spacing="0">
        <Grid Padding="16,18,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="⭐" FontSize="14" VerticalOptions="Center"/>
                <Label Text="Évaluations reçues" FontFamily="OpenSansSemibold" FontSize="14"
                       FontAttributes="Bold" TextColor="#0D1624" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Grid.Column="1"
                   Text="{Binding TotalReviews, StringFormat='{0} avis'}"
                   FontSize="12" TextColor="#7A879A"/>
        </Grid>

        <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
               Padding="16" Margin="16,0" HasShadow="True">
            <VerticalStackLayout Spacing="14">

                <!-- Note globale + distribution -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <VerticalStackLayout Grid.Column="0" Spacing="3" HorizontalOptions="Center">
                        <Label Text="{Binding AverageRating, StringFormat='{0:F1}'}"
                               FontFamily="OpenSansSemibold" FontSize="40"
                               FontAttributes="Bold" TextColor="#0D1624"
                               HorizontalTextAlignment="Center" LineHeight="1"/>
                        <Label Text="★★★★★" TextColor="#F59E0B" FontSize="16"
                               HorizontalTextAlignment="Center" CharacterSpacing="2"/>
                        <Label Text="{Binding TotalReviews, StringFormat='{0} avis'}"
                               FontSize="11" TextColor="#7A879A" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <CollectionView Grid.Column="1" ItemsSource="{Binding RatingBars}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dm:RatingBarDisplayModel">
                                <Grid ColumnSpacing="6" Margin="0,2" HeightRequest="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0"
                                           Text="{Binding Stars, StringFormat='{0}★'}"
                                           FontSize="11" TextColor="#7A879A" VerticalOptions="Center"/>
                                    <Grid Grid.Column="1" HeightRequest="6" VerticalOptions="Center">
                                        <BoxView CornerRadius="3" BackgroundColor="#EEF0F5" HorizontalOptions="Fill"/>
                                        <BoxView CornerRadius="3" BackgroundColor="#F59E0B"
                                                 HorizontalOptions="Start"
                                                 WidthRequest="{Binding FillPercent,
                                                     Converter={StaticResource RatioToWidth},
                                                     ConverterParameter='120'}"/>
                                    </Grid>
                                    <Label Grid.Column="2" Text="{Binding Count}"
                                           FontSize="11" TextColor="#7A879A"
                                           VerticalOptions="Center" HorizontalTextAlignment="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#0D000000" Margin="-16,0"/>

                <!-- Histogramme activité hebdo -->
                <Label Text="Activité hebdomadaire"
                       FontSize="11" TextColor="#7A879A" FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding WeeklyBars}"
                                SelectionMode="None" HeightRequest="80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dm:WeeklyActivityBarDisplayModel">
                            <VerticalStackLayout Spacing="4" WidthRequest="54">
                                <Label Text="{Binding ValueLabel}" FontSize="9" TextColor="#7A879A"
                                       HorizontalTextAlignment="Center"/>
                                <BoxView CornerRadius="3,3,0,0" HorizontalOptions="Fill"
                                         BackgroundColor="#FAEEDA"
                                         HeightRequest="{Binding HeightRatio,
                                             Converter={StaticResource RatioToHeight},
                                             ConverterParameter='60'}">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#EEF0F5"/>
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Text="{Binding WeekLabel}" FontSize="9" TextColor="#7A879A"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Insight -->
                <Frame BackgroundColor="#FAEEDA" CornerRadius="10"
                       BorderColor="Transparent" Padding="8" HasShadow="False">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⭐️" FontSize="13"/>
                        <Label Text="{Binding InsightText}"
                               FontSize="12" TextColor="#854F0B"
                               LineBreakMode="WordWrap" HorizontalOptions="Fill"/>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentView>
