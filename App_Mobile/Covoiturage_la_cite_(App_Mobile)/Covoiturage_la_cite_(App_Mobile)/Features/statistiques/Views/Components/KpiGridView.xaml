<?xml version="1.0" encoding="utf-8" ?>
<!-- Features/statistiques/Views/Components/KpiGridView.xaml -->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.statistiques.Views.Components.KpiGridView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.statistiques.DisplayModels"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:DataType="dm:KpiGridDisplayModel">

    <CollectionView ItemsSource="{Binding Cards}" SelectionMode="None"
                    Margin="16,0">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical"
                             Span="2"
                             HorizontalItemSpacing="10"
                             VerticalItemSpacing="10"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dm:KpiCardDisplayModel">
                <Frame BackgroundColor="White" CornerRadius="16"
                       BorderColor="#12000000" HasShadow="True" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions >
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <HorizontalStackLayout Spacing="12">

                            <!-- Icone -->
                            <Frame WidthRequest="36" HeightRequest="36"
                               CornerRadius="10" Padding="0"
                               BorderColor="Transparent"
                               BackgroundColor="{Binding IconBgHex}"
                               HorizontalOptions="Start">
                                <mi:MauiIcon
                                Icon="{Binding MaterialIcon, Converter={StaticResource MaterialIconConverter}}"
                                IconSize="18"
                                IconColor="{Binding IconColorHex}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                            </Frame>

                            <!-- Valeur + unite -->
                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Value}"
                                   FontFamily="OpenSansSemibold" FontSize="22"
                                   FontAttributes="Bold" TextColor="#0D1624"/>
                                <Label Text="{Binding Unit}"
                                   FontFamily="OpenSansRegular" FontSize="13"
                                   TextColor="#7A879A" VerticalOptions="End"
                                   Margin="0,0,0,3"
                                   IsVisible="{Binding Unit, Converter={StaticResource StringNotEmptyToBool}}"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                            <!-- Label -->
                            <Label Text="{Binding Label}"
                               FontFamily="OpenSansRegular" FontSize="11"
                               TextColor="#7A879A"/>

                            <!-- Tendance -->
                            <Label Text="{Binding TrendLabel}"
                               FontFamily="OpenSansSemibold" FontSize="11"
                               FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                             Binding="{Binding TrendIsPositive}" Value="True">
                                        <Setter Property="TextColor" Value="#1D9E75"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                             Binding="{Binding TrendIsPositive}" Value="False">
                                        <Setter Property="TextColor" Value="#E24B4A"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
