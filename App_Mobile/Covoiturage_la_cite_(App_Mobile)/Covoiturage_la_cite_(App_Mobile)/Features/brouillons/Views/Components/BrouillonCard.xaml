<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/brouillons/Views/Components/BrouillonCard.xaml
  BindingContext : BrouillonCardDisplayModel
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.brouillons.Views.Components.BrouillonCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.brouillons.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:BrouillonCardDisplayModel">

    <Border BackgroundColor="White" StrokeThickness="0" Margin="12,6">
        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="6" Opacity="1"/></Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto" Padding="16,14">

            <!-- ── Route ─────────────────────────────────────────────────── -->
            <HorizontalStackLayout Grid.Row="0" Spacing="6">
                <Label Text="{Binding Route.FromLabel}"
                       FontFamily="OpenSansSemibold" FontSize="15"
                       TextColor="#0D1624" FontAttributes="Bold"/>
                <Label Text="→" FontSize="15" TextColor="#7A879A"/>
                <Label Text="{Binding Route.ToLabel}"
                       FontFamily="OpenSansSemibold" FontSize="15"
                       TextColor="#0D1624" FontAttributes="Bold"/>
            </HorizontalStackLayout>

            <!-- ── Date + modifié ────────────────────────────────────────── -->
            <HorizontalStackLayout Grid.Row="1" Spacing="12" Margin="0,4,0,10">
                <Label Text="{Binding ScheduleLabel}"
                       FontSize="12" TextColor="#6B7280"/>
                <Label Text="·" FontSize="12" TextColor="#D1D5DB"/>
                <Label Text="{Binding ModifiedLabel}"
                       FontSize="12" TextColor="#9CA3AF"/>
            </HorizontalStackLayout>

            <!-- ── Complétion + bouton ───────────────────────────────────── -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <!-- Barre de progression -->
                    <Grid HeightRequest="6" BackgroundColor="#F1F3F5" Clip="RoundRectangle 3">
                        <BoxView HeightRequest="6" HorizontalOptions="Start"
                                 CornerRadius="3">
                            <BoxView.WidthRequest>
                                <Binding Path="CompletionPercent"
                                         Converter="{StaticResource RatioToHeight}"
                                         ConverterParameter="200"/>
                            </BoxView.WidthRequest>
                            <BoxView.Color>
                                <Binding Path="IsComplete">
                                    <Binding.Converter>
                                        <x:Static Member="x:null"/>
                                    </Binding.Converter>
                                </Binding>
                            </BoxView.Color>
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView"
                                             Binding="{Binding IsComplete}" Value="True">
                                    <Setter Property="Color" Value="#0F6E56"/>
                                </DataTrigger>
                                <DataTrigger TargetType="BoxView"
                                             Binding="{Binding IsComplete}" Value="False">
                                    <Setter Property="Color" Value="#1A56CC"/>
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </Grid>

                    <!-- Label complétion -->
                    <Label Text="{Binding CompletionLabel}"
                           FontSize="12" FontFamily="OpenSansSemibold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="TextColor" Value="#0F6E56"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsComplete}" Value="False">
                                <Setter Property="TextColor" Value="#6B7280"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <!-- Bouton Modifier -->
                <Border Grid.Column="1" Padding="14,8" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10"
                        VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding IsComplete}" Value="True">
                            <Setter Property="BackgroundColor" Value="#0F6E56"/>
                            <Setter Property="Stroke" Value="#0F6E56"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding IsComplete}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent"/>
                            <Setter Property="Stroke" Value="#D1D5DB"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontFamily="OpenSansSemibold" FontSize="13">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Text" Value="Publier"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsComplete}" Value="False">
                                <Setter Property="Text" Value="Modifier"/>
                                <Setter Property="TextColor" Value="#374151"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

            </Grid>
        </Grid>
    </Border>

</ContentView>
