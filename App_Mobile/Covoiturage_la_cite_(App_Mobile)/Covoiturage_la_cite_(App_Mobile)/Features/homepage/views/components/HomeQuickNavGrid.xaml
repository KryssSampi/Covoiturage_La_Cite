<?xml version="1.0" encoding="utf-8" ?>
<!-- Features/homepage/views/components/HomeQuickNavGrid.xaml -->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.homepage.views.components.HomeQuickNavGrid"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controllers="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.homepage.DisplayControler"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.homepage.DisplayModels"
    x:Name="Root"
    x:DataType="controllers:HomepageDisplayController">

    <CollectionView ItemsSource="{Binding QuickNav.Items}"
                    SelectionMode="None">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical"
                             Span="3"
                             HorizontalItemSpacing="12"
                             VerticalItemSpacing="14"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dm:HomeQuickNavItemDisplayModel">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding BindingContext.QuickNavCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border BackgroundColor="{Binding BackgroundHex}"
                                StrokeThickness="0"
                                HeightRequest="60" WidthRequest="60">
                            <Border.Behaviors>
                                <toolkit:TouchBehavior
                                    PressedOpacity="0.8"
                                    PressedScale="0.97"
                                    PressedBackgroundColor="#DCE5F2"/>
                            </Border.Behaviors>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid>
                                <mi:MauiIcon Icon="{Binding IconKey, Converter={StaticResource MaterialIconConverter}}"
                                             IconSize="28"
                                             IconColor="{Binding ForegroundHex}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                <Border IsVisible="{Binding BadgeText, Converter={StaticResource StringNotEmptyToBool}}"
                                        BackgroundColor="#E24B4A"
                                        HeightRequest="18" MinimumWidthRequest="18"
                                        StrokeThickness="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,-6,-6,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding BadgeText}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           Padding="4,0" />
                                </Border>
                            </Grid>
                        </Border>
                        <Label Text="{Binding Label}"
                               FontSize="12"
                               TextColor="#3D4A5C"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
