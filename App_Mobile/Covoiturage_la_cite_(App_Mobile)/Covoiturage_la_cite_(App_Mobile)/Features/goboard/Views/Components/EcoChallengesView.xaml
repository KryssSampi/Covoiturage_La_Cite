<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/goboard/Views/Components/EcoChallengesView.xaml
  BindingContext : EcoChallengesDisplayModel
  Largeur des barres de progression calculée en code-behind.
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.goboard.Views.Components.EcoChallengesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.goboard.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:EcoChallengesDisplayModel">

    <VerticalStackLayout Spacing="0">
        <Grid Padding="16,18,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="🌿" FontSize="14" VerticalOptions="Center"/>
                <Label Text="Défis Écologiques" FontFamily="OpenSansSemibold" FontSize="14"
                       FontAttributes="Bold" TextColor="#0D1624" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Grid.Column="1" Text="▼ CO₂" FontSize="12" TextColor="#7A879A"/>
        </Grid>

        <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
               Padding="0" Margin="16,0" HasShadow="True">
            <CollectionView ItemsSource="{Binding Challenges}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dm:EcoChallengeDisplayModel">
                        <VerticalStackLayout Padding="14,14,14,12" Spacing="8">

                            <!-- Titre + badge statut -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0"
                                       FontFamily="OpenSansSemibold" FontSize="13"
                                       FontAttributes="Bold" TextColor="#0D1624">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Emoji}" FontSize="14"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding Name}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Frame Grid.Column="1" CornerRadius="12" Padding="7,3"
                                       BorderColor="Transparent">
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="BackgroundColor" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Status}" Value="InProgress">
                                            <Setter Property="BackgroundColor" Value="#FAEEDA"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="BackgroundColor" Value="#EEF0F5"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                    <Label FontFamily="OpenSansSemibold" FontSize="10" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Text"      Value="Complété"/>
                                                <Setter Property="TextColor" Value="#0F6E56"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="InProgress">
                                                <Setter Property="Text"      Value="En cours"/>
                                                <Setter Property="TextColor" Value="#854F0B"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Locked">
                                                <Setter Property="Text"      Value="Verrouillé"/>
                                                <Setter Property="TextColor" Value="#545D6E"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Frame>
                            </Grid>

                            <Label Text="{Binding Description}"
                                   FontFamily="OpenSansRegular" FontSize="11"
                                   TextColor="#7A879A" LineBreakMode="WordWrap"/>

                            <!-- Barre de progression (track + fill en code-behind) -->
                            <Grid HeightRequest="8" x:Name="BarTrack">
                                <BoxView CornerRadius="4" BackgroundColor="#EEF0F5" HorizontalOptions="Fill"/>
                                <BoxView x:Name="ChallengeBar" CornerRadius="4"
                                         HorizontalOptions="Start" WidthRequest="0">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="BackgroundColor" Value="#1D9E75"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="InProgress">
                                            <Setter Property="BackgroundColor" Value="#BA7517"/>
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Text="{Binding TargetLabel}"
                                       FontSize="11" TextColor="#7A879A"/>
                                <Label Grid.Column="1"
                                       Text="{Binding ProgressPercent, StringFormat='{0:P0}'}"
                                       FontFamily="OpenSansSemibold" FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="TextColor" Value="#1D9E75"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="InProgress">
                                            <Setter Property="TextColor" Value="#BA7517"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Frame BackgroundColor="#FEF3C7" CornerRadius="10"
                                   BorderColor="Transparent" Padding="7,4"
                                   HorizontalOptions="Start" HasShadow="False"
                                   IsVisible="{Binding UnlockBadgeLabel, Converter={StaticResource NotNullToBool}}">
                                <Label Text="{Binding UnlockBadgeLabel}"
                                       FontSize="10" FontAttributes="Bold" TextColor="#92400E"/>
                            </Frame>

                            <BoxView HeightRequest="1" BackgroundColor="#0D000000" Margin="-14,4,-14,0"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>
    </VerticalStackLayout>
</ContentView>
