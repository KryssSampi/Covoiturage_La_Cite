<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/goboard/Views/Components/ScoreHistoryView.xaml
  BindingContext : ScoreHistoryDisplayModel
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.goboard.Views.Components.ScoreHistoryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.goboard.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:ScoreHistoryDisplayModel">

    <VerticalStackLayout Spacing="0">
        <Grid Padding="16,18,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="📜" FontSize="14" VerticalOptions="Center"/>
                <Label Text="Historique GoScore" FontFamily="OpenSansSemibold" FontSize="14"
                       FontAttributes="Bold" TextColor="#0D1624" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Grid.Column="1"
                   Text="{Binding TotalEvents, StringFormat='{0} événements'}"
                   FontSize="12" TextColor="#7A879A"/>
        </Grid>

        <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
               Padding="0" Margin="16,0" HasShadow="True">
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dm:ScoreHistoryEntryDisplayModel">
                            <Grid Padding="14,10" ColumnSpacing="12" BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                       CornerRadius="16" Padding="0"
                                       BackgroundColor="#E1F5EE" BorderColor="Transparent">
                                    <Label Text="✓" FontSize="14" TextColor="#1D9E75"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Label}"
                                           FontFamily="OpenSansSemibold" FontSize="12"
                                           FontAttributes="Bold" TextColor="#0D1624"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding DateLabel}"
                                           FontFamily="OpenSansRegular" FontSize="11"
                                           TextColor="#7A879A"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding Points, StringFormat='+{0}'}"
                                       FontFamily="OpenSansSemibold" FontSize="14"
                                       FontAttributes="Bold" TextColor="#1D9E75"
                                       VerticalOptions="Center"/>

                                <BoxView Grid.ColumnSpan="3" HeightRequest="1"
                                         BackgroundColor="#0D000000"
                                         VerticalOptions="End" Margin="-14,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Padding="16,10" HorizontalTextAlignment="Center"
                       FontSize="12" FontAttributes="Bold" TextColor="#1A56CC">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding TotalAccumulated}"/>
                            <Span Text=" pts accumulés · "/>
                            <Span Text="{Binding TotalEvents}"/>
                            <Span Text=" événements"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentView>
