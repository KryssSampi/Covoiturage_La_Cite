<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/goboard/Views/Components/LeaderboardView.xaml
  BindingContext : LeaderboardDisplayModel
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.goboard.Views.Components.LeaderboardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.goboard.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    x:DataType="dm:LeaderboardDisplayModel">

    <VerticalStackLayout Spacing="0">
        <Grid Padding="16,18,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="🏆" FontSize="14" VerticalOptions="Center"/>
                <Label Text="Classement du mois" FontFamily="OpenSansSemibold" FontSize="14"
                       FontAttributes="Bold" TextColor="#0D1624" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Grid.Column="1"
                   Text="{Binding TotalParticipants, StringFormat='{0} participants'}"
                   FontSize="12" TextColor="#7A879A"/>
        </Grid>

        <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
               Padding="0" Margin="16,0" HasShadow="True">
            <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dm:RankEntryDisplayModel">
                        <Grid Padding="12,11" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E8F0FE"/>
                                </DataTrigger>
                            </Grid.Triggers>

                            <!-- Médaille ou numéro -->
                            <Label Grid.Column="0"
                                   Text="{Binding MedalEmoji}"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding MedalEmoji}" Value="">
                                        <Setter Property="Text"      Value="{Binding Rank, StringFormat='#{0}'}"/>
                                        <Setter Property="FontSize"  Value="13"/>
                                        <Setter Property="TextColor" Value="#1A56CC"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Avatar -->
                            <Frame Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                   CornerRadius="17" Padding="0" BorderColor="Transparent"
                                   BackgroundColor="{Binding AvatarBgHex}" VerticalOptions="Center">
                                <Label Text="{Binding Initials}"
                                       FontFamily="OpenSansSemibold" FontSize="12"
                                       FontAttributes="Bold" TextColor="{Binding AvatarFgHex}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Frame>

                            <!-- Nom -->
                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}"
                                       FontFamily="OpenSansSemibold" FontSize="13"
                                       FontAttributes="Bold" TextColor="#0D1624">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMe}" Value="True">
                                            <Setter Property="TextColor" Value="#1A56CC"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <!-- Score -->
                            <Label Grid.Column="3"
                                   Text="{Binding Score}"
                                   FontFamily="OpenSansSemibold" FontSize="14"
                                   FontAttributes="Bold" TextColor="#0D1624"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMe}" Value="True">
                                        <Setter Property="TextColor" Value="#1A56CC"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Label Padding="16,10"
                           Text="{Binding HiddenCount, StringFormat='… {0} autres participants'}"
                           HorizontalTextAlignment="Center"
                           FontSize="12" TextColor="#7A879A"/>
                </CollectionView.Footer>
            </CollectionView>
        </Frame>
    </VerticalStackLayout>
</ContentView>
