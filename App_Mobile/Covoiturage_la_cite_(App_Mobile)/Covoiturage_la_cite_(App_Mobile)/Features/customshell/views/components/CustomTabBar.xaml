<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/shell/views/components/shared/CustomTabBar.xaml
  TabBar entièrement custom avec :
    - Style "carte" (#08316e / blanc) sur l'item sélectionné
    - Bouton Home central en relief
    - Items et couleurs pilotés par TabBarConfig.cs
    - Aucune modification XAML nécessaire pour personnaliser
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.shell.views.components.CustomTabBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="68"
    VerticalOptions="End">

    <!--
      Le Grid racine est construit entièrement en code-behind
      (nombre de colonnes dynamique selon TabBarConfig.Items.Count).
      On expose uniquement le conteneur ici.
    -->
    <Grid
        x:Name="RootTabGrid"
        BackgroundColor="White"
        HeightRequest="68">

        <!-- Séparateur haut -->
        <BoxView
            x:Name="TopBorder"
            HeightRequest="1"
            BackgroundColor="#12000000"
            VerticalOptions="Start"
            HorizontalOptions="Fill"/>

    </Grid>

</ContentView>
