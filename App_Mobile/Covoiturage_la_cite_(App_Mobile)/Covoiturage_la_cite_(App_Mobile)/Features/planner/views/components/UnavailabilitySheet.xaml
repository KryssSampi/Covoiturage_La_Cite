<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/planner/views/components/UnavailabilitySheet.xaml
  Bottom sheet CRUD indisponibilités :
  - Info banner bleu
  - Formulaire : date (optionnelle), heure début/fin
  - Toggle récurrent + cases jours de la semaine
  - CTA Annuler / Confirmer
  - Liste existante avec suppression (impact visuel immédiat)
  BindingContext : PlannerDisplayController
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.planner.views.components.UnavailabilitySheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.planner.DisplayModels"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:conv="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <!-- Backdrop -->
    <ContentView.Content>
        <Grid>
            <!-- Voile sombre -->
            <BoxView BackgroundColor="#73000000"
                     IsVisible="{Binding IsSheetOpen}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseSheetCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Sheet panel -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Stroke="Transparent"
                    Padding="0"
                    VerticalOptions="End"
                    MaximumHeightRequest="620"
                    IsVisible="{Binding IsSheetOpen}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0"/>
                </Border.StrokeShape>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Handle + titre -->
                        <RowDefinition Height="*"/>      <!-- Scroll content -->
                        <RowDefinition Height="Auto"/>   <!-- CTA footer -->
                    </Grid.RowDefinitions>

                    <!-- ── Handle + Titre ── -->
                    <VerticalStackLayout Grid.Row="0" Spacing="0">
                        <!-- Handle drag -->
                        <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                                 BackgroundColor="#D8DBE5" HorizontalOptions="Center"
                                 Margin="0,10,0,4"/>

                        <Grid Padding="20,4,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Mes disponibilités"
                                   FontFamily="OpenSansSemibold" FontSize="16"
                                   FontAttributes="Bold" TextColor="#0D1624"/>
                            <Frame Grid.Column="1" WidthRequest="30" HeightRequest="30"
                                   CornerRadius="15" BackgroundColor="#EEF0F5"
                                   BorderColor="Transparent" Padding="0" HasShadow="False">
                                <mi:MauiIcon Icon="{mi:Material Icon=Close}"
                                             IconSize="14" IconColor="#3D4A5C"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                                    <mi:MauiIcon.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CloseSheetCommand}"/>
                                    </mi:MauiIcon.GestureRecognizers>
                                </mi:MauiIcon>
                            </Frame>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
                    </VerticalStackLayout>

                    <!-- ── Contenu scrollable ── -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Spacing="0"
                                             BindingContext="{Binding SheetForm}">

                            <!-- Info banner -->
                            <Frame BackgroundColor="#E8F0FE" CornerRadius="12"
                                   BorderColor="Transparent" Padding="12,10"
                                   Margin="20,14,20,0" HasShadow="False">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Renseignez vos indisponibilités"
                                           FontFamily="OpenSansSemibold" FontSize="13"
                                           FontAttributes="Bold" TextColor="#08316e"/>
                                    <Label Text="Indiquez les périodes où vous n'êtes pas disponible. Cela nous permet de vous suggérer des trajets plus pertinents."
                                           FontSize="12" TextColor="#0D3A8C"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- ── Formulaire ── -->
                            <VerticalStackLayout Padding="20,14,20,10" Spacing="12">

                                <Label Text="Ajouter une indisponibilité"
                                       FontFamily="OpenSansSemibold" FontSize="13"
                                       FontAttributes="Bold" TextColor="#0D1624"/>

                                <!-- Date (optionnelle) -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="DATE (OPTIONNELLE)"
                                           FontFamily="OpenSansSemibold" FontSize="11"
                                           TextColor="#7A879A" CharacterSpacing="0.6"/>
                                    <Frame BackgroundColor="#F8F9FC" CornerRadius="12"
                                           BorderColor="#D8DBE5" Padding="12,10"
                                           HasShadow="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <mi:MauiIcon Icon="{mi:Material Icon=CalendarToday}" IconSize="16" IconColor="#7A879A" VerticalOptions="Center" Margin="0,0,8,0" />
                                            <DatePicker Grid.Column="1"
                                                        x:Name="DatePickerField"
                                                        Format="dd/MM/yyyy"
                                                        TextColor="#0D1624"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="14"
                                                        BackgroundColor="Transparent"/>
                                            <mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=Close}" IconSize="14" IconColor="#8A95A8" VerticalOptions="Center" IsVisible="{Binding SelectedDate, Converter={StaticResource NotNullToBool}}" >
                                                <mi:MauiIcon.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SetSheetDateCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}" CommandParameter="{x:Null}"/>
                                                </mi:MauiIcon.GestureRecognizers>
                                            </mi:MauiIcon>
                                        </Grid>
                                    </Frame>
                                    <!-- Avertissement date = pas de récurrence -->
                                    <Label Text="Date sélectionnée — Récurrent désactivé"
                                           FontSize="11" TextColor="#BA7517"
                                           IsVisible="{Binding SelectedDate,
                                               Converter={StaticResource NotNullToBool}}"/>
                                </VerticalStackLayout>

                                <!-- Heure début -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="HEURE DE DÉBUT"
                                           FontFamily="OpenSansSemibold" FontSize="11"
                                           TextColor="#7A879A" CharacterSpacing="0.6"/>
                                    <Frame BackgroundColor="#F8F9FC" CornerRadius="12"
                                           BorderColor="#D8DBE5" Padding="12,10"
                                           HasShadow="False">
                                        <HorizontalStackLayout Spacing="8">
                                            <mi:MauiIcon Icon="{mi:Material Icon=AccessTime}" IconSize="16" IconColor="#7A879A" />
                                            <TimePicker x:Name="StartTimePicker"
                                                        BackgroundColor="Transparent"
                                                        FontFamily="OpenSansRegular" FontSize="14"
                                                        TextColor="#0D1624"/>
                                        </HorizontalStackLayout>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Heure fin -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="HEURE DE FIN"
                                           FontFamily="OpenSansSemibold" FontSize="11"
                                           TextColor="#7A879A" CharacterSpacing="0.6"/>
                                    <Frame BackgroundColor="#F8F9FC" CornerRadius="12"
                                           BorderColor="#D8DBE5" Padding="12,10"
                                           HasShadow="False">
                                        <HorizontalStackLayout Spacing="8">
                                            <mi:MauiIcon Icon="{mi:Material Icon=AccessTime}" IconSize="16" IconColor="#7A879A" />
                                            <TimePicker x:Name="EndTimePicker"
                                                        BackgroundColor="Transparent"
                                                        FontFamily="OpenSansRegular" FontSize="14"
                                                        TextColor="#0D1624"/>
                                        </HorizontalStackLayout>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Toggle récurrent -->
                                <Frame BackgroundColor="#F8F9FC" CornerRadius="12"
                                       BorderColor="#D8DBE5" Padding="12,10"
                                       HasShadow="False" Opacity="{Binding RecurrentEnabled,
                                           Converter={StaticResource BoolToOpacityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Récurrent"
                                                   FontFamily="OpenSansSemibold" FontSize="13"
                                                   FontAttributes="Bold" TextColor="#0D1624"/>
                                            <Label Text="Se répète chaque semaine"
                                                   FontSize="11" TextColor="#7A879A"/>
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1"
                                                IsToggled="{Binding IsRecurrent}"
                                                OnColor="#1D9E75" ThumbColor="White"
                                                x:Name="RecurrentSwitch"
                                                IsEnabled="{Binding RecurrentEnabled}"/>
                                    </Grid>
                                </Frame>

                                <!-- Cases jours (visible si récurrent activé) -->
                                <FlexLayout x:Name="WeekdayPicker"
                                            Wrap="Wrap" 
                                            IsVisible="{Binding IsRecurrent}">
                                    <!-- Lundi -->
                                    <Frame x:Name="DayLun" WidthRequest="44" HeightRequest="52"
                                           CornerRadius="10" Padding="0" HasShadow="False"
                                           BackgroundColor="#EEF0F5" BorderColor="#D8DBE5">
                                        <VerticalStackLayout HorizontalOptions="Center"
                                                             VerticalOptions="Center" Spacing="3">
                                            <Label Text="L" FontFamily="OpenSansSemibold"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="#7A879A"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label Text="Lun" FontSize="10"
                                                   TextColor="#7A879A"
                                                   HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding ToggleDayCommand,
                                                    Source={RelativeSource
                                                        AncestorType={x:Type ContentView}}}"
                                                CommandParameter="{x:Static sys:DayOfWeek.Monday}"/>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                    <!-- Les autres jours générés identiquement en code-behind -->
                                </FlexLayout>

                            </VerticalStackLayout>

                            <!-- ── Liste des indisponibilités existantes ── -->
                            <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
                            <VerticalStackLayout Padding="20,14,20,14" Spacing="8">
                                <Label Text="Vos indisponibilités"
                                       FontFamily="OpenSansSemibold" FontSize="13"
                                       FontAttributes="Bold" TextColor="#0D1624"/>

                                <CollectionView ItemsSource="{Binding ExistingItems}"
                                                SelectionMode="None">
                                    <CollectionView.EmptyView>
                                        <Label Text="Aucune indisponibilité enregistrée."
                                               FontSize="12" TextColor="#7A879A"
                                               HorizontalTextAlignment="Center"
                                               Padding="0,8"/>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="dm:UnavailabilityDisplayModel">
                                            <Frame BackgroundColor="#F8F9FC" CornerRadius="12"
                                                   BorderColor="#0D000000" Padding="10,10"
                                                   Margin="0,0,0,8" HasShadow="False">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icône rouge -->
                                                    <Frame Grid.Column="0"
                                                           WidthRequest="32" HeightRequest="32"
                                                           CornerRadius="8" Padding="0"
                                                           BackgroundColor="#FCEBEB"
                                                           BorderColor="Transparent"
                                                           HasShadow="False">
                                                           <mi:MauiIcon Icon="{mi:Material Icon=Info}" IconSize="15" IconColor="#E24B4A" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Frame>

                                                    <!-- Titre + détail -->
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="2">
                                                        <Label Text="{Binding Title}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="#0D1624"
                                                               LineBreakMode="WordWrap"/>
                                                        <Label Text="{Binding Detail}"
                                                               FontSize="11"
                                                               TextColor="#7A879A"/>
                                                    </VerticalStackLayout>

                                                    <!-- Bouton supprimer -->
                                                    <mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=Close}" IconSize="18" IconColor="#8A95A8" VerticalOptions="Center">
                                                        <mi:MauiIcon.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding DeleteUnavailabilityCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}" CommandParameter="{Binding Id}"/>
                                                        </mi:MauiIcon.GestureRecognizers>
                                                    </mi:MauiIcon>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- ── Footer CTA ── -->
                    <Grid Grid.Row="2" Padding="20,14,20,20"
                          ColumnSpacing="10"
                          BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <BoxView Grid.ColumnSpan="2" HeightRequest="1"
                                 BackgroundColor="#0D000000"
                                 VerticalOptions="Start" Margin="-20,-14,-20,0"/>
                        <Button Grid.Column="0"
                                Text="Annuler"
                                BackgroundColor="#EEF0F5" TextColor="#3D4A5C"
                                FontFamily="OpenSansSemibold" FontSize="14"
                                CornerRadius="14" HeightRequest="52"
                                Command="{Binding CloseSheetCommand}"/>
                        <Button Grid.Column="1"
                                Text="Confirmer"
                                BackgroundColor="#0F6E56" TextColor="White"
                                FontFamily="OpenSansSemibold" FontSize="14"
                                FontAttributes="Bold" CornerRadius="14" HeightRequest="52"
                                Command="{Binding ConfirmUnavailabilityCommand}"
                                IsEnabled="{Binding SheetForm.IsSaving,
                                    Converter={StaticResource InverseBoolConverter},
                                    FallbackValue=True}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentView.Content>
</ContentView>


