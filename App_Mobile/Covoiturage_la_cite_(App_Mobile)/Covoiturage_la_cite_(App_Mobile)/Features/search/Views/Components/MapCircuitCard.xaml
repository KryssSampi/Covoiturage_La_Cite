<?xml version="1.0" encoding="utf-8" ?>
<!--
  Features/search/Views/Components/MapCircuitCard.xaml
  Carte "circuit" affichée dans les résultats conducteur.
  Minimap placeholder, adresses From→To, via, durée / distance, CTA vert.
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Features.search.Views.Components.MapCircuitCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.search.DisplayModels">

    <Frame BackgroundColor="White" CornerRadius="16"
           BorderColor="#12000000" HasShadow="True"
           Padding="0" IsClippedToBounds="True">
        <VerticalStackLayout Spacing="0">

            <!-- ── Minimap placeholder ── -->
            <Grid HeightRequest="120">
                <Image x:Name="MapImage"
                       Aspect="AspectFill"
                       BackgroundColor="#E8F0FE"/>

                <!-- Gradient overlay bas -->
                <BoxView VerticalOptions="End" HeightRequest="40">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="White" Offset="1"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Marqueur A (From) -->
                <Frame WidthRequest="28" HeightRequest="28"
                       CornerRadius="14" Padding="0"
                       BackgroundColor="#1A56CC" BorderColor="White"
                       HasShadow="True"
                       HorizontalOptions="Start" VerticalOptions="Start"
                       Margin="16,16,0,0">
                    <Label Text="A" FontFamily="OpenSansSemibold"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Frame>

                <!-- Marqueur B (To) -->
                <Frame WidthRequest="28" HeightRequest="28"
                       CornerRadius="14" Padding="0"
                       BackgroundColor="#E24B4A" BorderColor="White"
                       HasShadow="True"
                       HorizontalOptions="End" VerticalOptions="End"
                       Margin="0,0,16,16">
                    <Label Text="B" FontFamily="OpenSansSemibold"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Frame>

                <!-- Badge label (ex: "Principal") -->
                <Frame CornerRadius="8" Padding="7,4"
                       HasShadow="True" BorderColor="Transparent"
                       BackgroundColor="#E8F0FE"
                       HorizontalOptions="Start" VerticalOptions="End"
                       Margin="12,0,0,12">
                    <Label Text="{Binding Label}"
                           FontFamily="OpenSansSemibold" FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{Binding LabelColorHex}"/>
                </Frame>
            </Grid>

            <!-- ── Infos trajet ── -->
            <VerticalStackLayout Padding="14,10,14,10" Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <VerticalStackLayout Grid.Column="0" Spacing="12" WidthRequest="8">
                        <Ellipse WidthRequest="8" HeightRequest="8"
                                 Fill="#1A56CC" VerticalOptions="Start"
                                 Margin="0,3,0,0"/>
                        <BoxView WidthRequest="2" HeightRequest="16"
                                 BackgroundColor="#D8DBE5"
                                 HorizontalOptions="Center"/>
                        <Ellipse WidthRequest="8" HeightRequest="8"
                                 Fill="#E24B4A" VerticalOptions="End"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="{Binding FromAddress}"
                               FontFamily="OpenSansSemibold" FontSize="13"
                               TextColor="#0D1624" LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding ToAddress}"
                               FontFamily="OpenSansSemibold" FontSize="13"
                               TextColor="#0D1624" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                </Grid>
                <Label Text="{Binding Via}"
                       FontSize="12" TextColor="#7A879A"/>
            </VerticalStackLayout>

            <!-- ── Durée / Distance ── -->
            <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
            <Grid Padding="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Label Text="&#xF150;" FontFamily="FluentFilledIcons"
                           FontSize="18" TextColor="#1A56CC"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding DurationMinutes, StringFormat='{0}'}"
                           FontFamily="OpenSansSemibold" FontSize="14"
                           FontAttributes="Bold" TextColor="#0D1624"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Durée" FontSize="11" TextColor="#7A879A"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="1" WidthRequest="1"
                         BackgroundColor="#0D000000" VerticalOptions="Fill"/>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Label Text="&#xF1EB;" FontFamily="FluentFilledIcons"
                           FontSize="18" TextColor="#0F6E56"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding DistanceKm, StringFormat='{0:F1} km'}"
                           FontFamily="OpenSansSemibold" FontSize="14"
                           FontAttributes="Bold" TextColor="#0D1624"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Distance" FontSize="11" TextColor="#7A879A"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ── CTA ── -->
            <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
            <Button x:Name="CtaButton"
                    Text="{Binding CtaLabel}"
                    BackgroundColor="#0F6E56" TextColor="White"
                    FontFamily="OpenSansSemibold" FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="0"
                    HeightRequest="52"
                    Margin="0"/>
        </VerticalStackLayout>
    </Frame>
</ContentView>
