<?xml version="1.0" encoding="utf-8" ?>
<!--
  Shared/ItemList/views/ItemListView.xaml
  ════════════════════════════════════════════════════════════════════════
  Composant générique de liste avec :
    - Barre de recherche (filtre les items par propriétés string)
    - Bouton Filtre → menu contextuel multi-sélection (cases à cocher)
    - Bouton Tri    → menu contextuel sélection unique
    - Chips des filtres/tri actifs (supprimables)
    - CollectionView des items passés en DataTemplate
    - État vide (EmptyState)
    - État no-internet (NoInternetState)

  Usage :
    <list:ItemListView x:Name="MyList" DataTemplate="{StaticResource MyCardTemplate}"/>
    code-behind : MyList.SetController(myController);
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Shared.ItemList.Views.ItemListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Barre recherche + boutons -->
            <RowDefinition Height="Auto"/>  <!-- Chips filtres actifs -->
            <RowDefinition Height="*"/>     <!-- Liste / états vide / no-internet -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             ROW 0 : BARRE DE RECHERCHE + BOUTONS
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Padding="16,10,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Btn Filtre -->
                <ColumnDefinition Width="*"/>     <!-- SearchBar -->
                <ColumnDefinition Width="Auto"/>  <!-- Btn Tri -->
            </Grid.ColumnDefinitions>

            <!-- ── Bouton Filtre ── -->
            <Button Grid.Column="0"
                    x:Name="FilterButton"
                    WidthRequest="42" HeightRequest="42"
                    Padding="0" CornerRadius="12"
                    BackgroundColor="#EEF0F5"
                    Command="{Binding ToggleFilterMenuCommand}">
                <!-- Icône Fluent "Filter" -->
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentRegularIcons"
                        Glyph="&#xF230;"
                        Size="20"
                        Color="#3D4A5C"/>
                </Button.ImageSource>
                <!-- Change couleur si filtre actif -->
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding HasActiveFiltersOrSort}" Value="True">
                        <Setter Property="BackgroundColor" Value="#08316e"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- ── Barre de recherche ── -->
            <Frame Grid.Column="1"
                   BackgroundColor="#F8F9FC"
                   BorderColor="#D8DBE5"
                   CornerRadius="12" Padding="0"
                   HasShadow="False">
                <Frame.Triggers>
                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding IsFilterMenuOpen}" Value="True">
                        <Setter Property="BorderColor" Value="#1A56CC"/>
                    </DataTrigger>
                </Frame.Triggers>
                <Grid ColumnSpacing="0" HeightRequest="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icône loupe -->
                    <Label Grid.Column="0"
                           Text="&#xF1EB;"
                           FontFamily="FluentRegularIcons"
                           FontSize="18" TextColor="#8A95A8"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>

                    <!-- Input -->
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="{Binding SearchPlaceholder}"
                           PlaceholderColor="#8A95A8"
                           TextColor="#0D1624"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           ReturnType="Search"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           Text="{Binding SearchText, Mode=TwoWay}"/>

                    <!-- Clear button -->
                    <Button Grid.Column="2"
                            x:Name="ClearSearchButton"
                            BackgroundColor="Transparent"
                            Padding="0"
                            IsVisible="False">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FluentFilledIcons"
                                Glyph="&#xE8BB;"
                                Size="16"
                                Color="#8A95A8"/>
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Frame>

            <!-- ── Bouton Tri ── -->
            <Button Grid.Column="2"
                    x:Name="SortButton"
                    WidthRequest="42" HeightRequest="42"
                    Padding="0" CornerRadius="12"
                    BackgroundColor="#EEF0F5"
                    Command="{Binding ToggleSortMenuCommand}">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentRegularIcons"
                        Glyph="&#xF1F7;"
                        Size="20"
                        Color="#3D4A5C"/>
                </Button.ImageSource>
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding HasActiveFiltersOrSort}" Value="True">
                        <Setter Property="BackgroundColor" Value="#08316e"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             MENU CONTEXTUEL FILTRE (superposé)
        ══════════════════════════════════════════════════════ -->
        <Frame x:Name="FilterMenu"
               Grid.Row="0" Grid.RowSpan="2"
               BackgroundColor="White"
               CornerRadius="16" BorderColor="#D8DBE5"
               Padding="0" Margin="16,52,16,0"
               ZIndex="100" HasShadow="True"
               IsVisible="{Binding IsFilterMenuOpen}"
               VerticalOptions="Start">
            <VerticalStackLayout Spacing="0">

                <!-- En-tête -->
                <Grid Padding="14,12,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Text="Filtres"
                           FontFamily="OpenSansSemibold" FontSize="15"
                           FontAttributes="Bold" TextColor="#0D1624"/>
                    <Button Grid.Column="1" Text="Tout effacer"
                            BackgroundColor="Transparent" TextColor="#E24B4A"
                            FontFamily="OpenSansSemibold" FontSize="12"
                            Padding="0" HeightRequest="30"
                            Command="{Binding ClearAllCommand}"/>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>

                <!-- Liste des groupes de filtres -->
                <CollectionView x:Name="FilterGroupsCollection"
                                SelectionMode="None"
                                ItemsSource="{Binding FilterGroups}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <!-- Titre de groupe (optionnel) -->
                                <Label Text="{Binding GroupLabel}"
                                       Padding="14,10,14,6"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#7A879A"
                                       CharacterSpacing="0.7"
                                       IsVisible="{Binding GroupLabel,
                                           Converter={StaticResource StringNotEmptyToBool}}"/>

                                <!-- Items filtres -->
                                <CollectionView ItemsSource="{Binding Filters}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Chaque item = label + checkbox -->
                                            <Grid Padding="14,10,14,10"
                                                  BackgroundColor="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>

                                                <Label Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="14"
                                                       TextColor="#0D1624"
                                                       VerticalOptions="Center"/>

                                                <!-- Case à cocher custom -->
                                                <Frame Grid.Column="1"
                                                       WidthRequest="22" HeightRequest="22"
                                                       CornerRadius="6"
                                                       BorderColor="#D8DBE5"
                                                       Padding="0" HasShadow="False"
                                                       BackgroundColor="White">
                                                    <Frame.Triggers>
                                                        <DataTrigger TargetType="Frame"
                                                                     Binding="{Binding IsActive}"
                                                                     Value="True">
                                                            <Setter Property="BackgroundColor" Value="#08316e"/>
                                                            <Setter Property="BorderColor"     Value="#08316e"/>
                                                        </DataTrigger>
                                                    </Frame.Triggers>
                                                    <Label Text="&#xF297;"
                                                           FontFamily="FluentFilledIcons"
                                                           FontSize="12" TextColor="White"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"
                                                           IsVisible="{Binding IsActive}"/>
                                                </Frame>

                                                <!-- Tap sur toute la ligne -->
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding ToggleFilterCommand,
                                                            Source={RelativeSource
                                                                AncestorType={x:Type ContentView}}}"
                                                        CommandParameter="{Binding .}"/>
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>

        <!-- ══════════════════════════════════════════════════════
             MENU CONTEXTUEL TRI (superposé)
        ══════════════════════════════════════════════════════ -->
        <Frame x:Name="SortMenu"
               Grid.Row="0" Grid.RowSpan="2"
               BackgroundColor="White"
               CornerRadius="16" BorderColor="#D8DBE5"
               Padding="0" Margin="16,52,16,0"
               ZIndex="100" HasShadow="True"
               IsVisible="{Binding IsSortMenuOpen}"
               VerticalOptions="Start">
            <VerticalStackLayout Spacing="0">

                <Label Text="Trier par"
                       Padding="14,12,14,10"
                       FontFamily="OpenSansSemibold" FontSize="15"
                       FontAttributes="Bold" TextColor="#0D1624"/>
                <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>

                <CollectionView x:Name="SortOptionsCollection"
                                SelectionMode="None"
                                ItemsSource="{Binding SortOptions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,12,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding Label}"
                                       FontFamily="OpenSansRegular" FontSize="14"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor"       Value="#08316e"/>
                                            <Setter Property="FontAttributes"  Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="TextColor" Value="#0D1624"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Point actif -->
                                <Ellipse Grid.Column="1"
                                         WidthRequest="8" HeightRequest="8"
                                         Fill="#08316e" VerticalOptions="Center"
                                         IsVisible="{Binding IsActive}"/>

                                <BoxView Grid.ColumnSpan="2"
                                         HeightRequest="1" BackgroundColor="#0D000000"
                                         VerticalOptions="End"/>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectSortCommand,
                                            Source={RelativeSource
                                                AncestorType={x:Type ContentView}}}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>

        <!-- ══════════════════════════════════════════════════════
             ROW 1 : CHIPS FILTRES / TRI ACTIFS
        ══════════════════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="1" Spacing="0"
                             IsVisible="{Binding HasActiveFiltersOrSort}">
            <BoxView HeightRequest="1" BackgroundColor="#0D000000" Margin="16,0"/>

            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="16,8,16,8">
                <HorizontalStackLayout x:Name="ChipsContainer" Spacing="8"/>
            </ScrollView>
        </VerticalStackLayout>

        <!-- ══════════════════════════════════════════════════════
             ROW 2 : LISTE / ÉTATS
        ══════════════════════════════════════════════════════ -->

        <!-- Liste principale -->
        <CollectionView
            Grid.Row="2"
            x:Name="MainList"
            SelectionMode="None"
            ItemsSource="{Binding DisplayedItems}"
            IsVisible="{Binding ShowList}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <!-- DataTemplate injecté depuis le code-behind via ItemTemplate -->
        </CollectionView>

        <!-- État vide -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding ShowEmpty}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12" Padding="32">
            <!-- Icône -->
            <Frame WidthRequest="64" HeightRequest="64" CornerRadius="32"
                   BackgroundColor="#EEF0F5" BorderColor="Transparent"
                   HasShadow="False" HorizontalOptions="Center">
                <Label Text="{Binding EmptyIconGlyph}"
                       FontFamily="FluentRegularIcons"
                       FontSize="30" TextColor="#8A95A8"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Frame>
            <Label Text="{Binding EmptyTitle}"
                   FontFamily="OpenSansSemibold" FontSize="16"
                   FontAttributes="Bold" TextColor="#3D4A5C"
                   HorizontalTextAlignment="Center"/>
            <Label Text="{Binding EmptySubtitle}"
                   FontSize="13" TextColor="#7A879A"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>
        </VerticalStackLayout>

        <!-- État no-internet -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding ShowNoInternet}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12" Padding="32">
            <Frame WidthRequest="64" HeightRequest="64" CornerRadius="32"
                   BackgroundColor="#FCEBEB" BorderColor="Transparent"
                   HasShadow="False" HorizontalOptions="Center">
                <Label Text="{Binding NoInternetIconGlyph}"
                       FontFamily="FluentRegularIcons"
                       FontSize="30" TextColor="#E24B4A"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Frame>
            <Label Text="{Binding NoInternetTitle}"
                   FontFamily="OpenSansSemibold" FontSize="16"
                   FontAttributes="Bold" TextColor="#3D4A5C"
                   HorizontalTextAlignment="Center"/>
            <Label Text="{Binding NoInternetSubtitle}"
                   FontSize="13" TextColor="#7A879A"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>
            <Button Text="Réessayer"
                    BackgroundColor="#1A56CC" TextColor="White"
                    FontFamily="OpenSansSemibold" FontSize="13"
                    CornerRadius="12" HeightRequest="44" Padding="24,0"
                    x:Name="RetryButton"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>

    </Grid>
</ContentView>

