<?xml version="1.0" encoding="utf-8" ?>
<!-- Shared/Cards/Views/IncomingReservationRequestCard.xaml -->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Shared.Cards.Views.IncomingReservationRequestCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Cards.DisplayModels"
    x:DataType="dm:IncomingReservationRequestCardDisplayModel">

    <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
           HasShadow="True" Padding="0" IsClippedToBounds="True">
        <VerticalStackLayout>
            <Grid Padding="13,12,13,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0" WidthRequest="44" HeightRequest="44"
                       CornerRadius="22" Padding="0" BorderColor="Transparent"
                       BackgroundColor="{Binding PassengerAvatar.BackgroundHex}">
                    <Label Text="{Binding PassengerAvatar.Initials}"
                           FontFamily="OpenSansSemibold" FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{Binding PassengerAvatar.ForegroundHex}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Frame>

                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{Binding PassengerName}"
                               FontFamily="OpenSansSemibold" FontSize="14"
                               FontAttributes="Bold" TextColor="#1A56CC"/>
                        <mi:MauiIcon Icon="{mi:Material Icon=Star}"
                                     IconSize="15" IconColor="#F59E0B"
                                     Margin="0,-4,0,0"/>
                        <Label Text="{Binding PassengerRating, StringFormat='{0:F1}'}"
                               FontSize="12" TextColor="#BA7517"/>
                        <Label Text="{Binding PassengerTripCount, StringFormat='({0} trajets)'}"
                               FontSize="12" TextColor="#7A879A"/>
                    </HorizontalStackLayout>
                    <Label Text="Veut rejoindre votre trajet :"
                           FontSize="12" TextColor="#3D4A5C"/>
                    <HorizontalStackLayout Spacing="5">
                        <Ellipse WidthRequest="7" HeightRequest="7"
                                 Fill="#1A56CC" VerticalOptions="Center"/>
                        <Label Text="{Binding Route.FromLabel}"
                               FontSize="12" TextColor="#3D4A5C"/>
                        <mi:MauiIcon Icon="{mi:Material Icon=ChevronRight}"
                                     IconSize="12" IconColor="#8A95A8"/>
                        <Ellipse WidthRequest="7" HeightRequest="7"
                                 Fill="#E24B4A" VerticalOptions="Center"/>
                        <Label Text="{Binding Route.ToLabel}"
                               FontSize="12" TextColor="#3D4A5C"/>
                        <Label Text="{Binding SeatsInfo, StringFormat='� 0/{0}'}"
                               FontSize="12" TextColor="#7A879A"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding TripTimeLabel}"
                               FontSize="12" TextColor="#7A879A"/>
                        <Label Text="�" FontSize="12" TextColor="#7A879A"/>
                        <Label Text="{Binding Price, StringFormat='{0:F0} CAD'}"
                               FontFamily="OpenSansSemibold" FontSize="12"
                               FontAttributes="Bold" TextColor="#1A56CC"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
            <Grid Padding="12,9,12,11" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="Refuser"
                        BackgroundColor="#EEF0F5" TextColor="#3D4A5C"
                        FontFamily="OpenSansSemibold" FontSize="12"
                        CornerRadius="10" HeightRequest="40"
                        x:Name="DeclineButton"/>
                <Button Grid.Column="1" Text="Accepter"
                        BackgroundColor="#1D9E75" TextColor="White"
                        FontFamily="OpenSansSemibold" FontSize="12"
                        CornerRadius="10" HeightRequest="40"
                        x:Name="AcceptButton"/>
            </Grid>
        </VerticalStackLayout>
    </Frame>
</ContentView>
