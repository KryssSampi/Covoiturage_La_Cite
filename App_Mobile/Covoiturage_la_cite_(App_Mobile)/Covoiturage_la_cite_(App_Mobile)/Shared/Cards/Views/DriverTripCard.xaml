<?xml version="1.0" encoding="utf-8" ?>
<!--
  Shared/Cards/views/DriverTripCard.xaml
  Carte trajet conducteur — 5 états via DataTriggers
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Shared.Cards.Views.DriverTripCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Cards.DisplayModels"
    xmlns:conv="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Converters">

    <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
           HasShadow="True" Padding="0" IsClippedToBounds="True">
        <VerticalStackLayout>

            <!-- ── Bandeau statut "En cours" (visible uniquement si InProgress) ── -->
            <Grid x:Name="InProgressBanner" IsVisible="False"
                  BackgroundColor="#1A56CC" Padding="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <HorizontalStackLayout Spacing="8">
                    <!-- Dot animé -->
                    <Ellipse WidthRequest="8" HeightRequest="8"
                             Fill="#7EFFD4" VerticalOptions="Center"/>
                    <Label Text="En cours" FontFamily="OpenSansSemibold"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="White" CharacterSpacing="0.5"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Column="1"
                       Text="{Binding EtaLabel}"
                       FontFamily="OpenSansSemibold" FontSize="14"
                       FontAttributes="Bold" TextColor="White"/>
            </Grid>

            <!-- ── Corps principal ── -->
            <Grid Padding="13,12,13,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Miniature destination -->
                <Frame Grid.Column="0" WidthRequest="52" HeightRequest="52"
                       CornerRadius="12" Padding="0"
                       BackgroundColor="#E8F0FE" BorderColor="Transparent">
                    <Label Text="&#xF51C;" FontFamily="FluentFilledIcons"
                           FontSize="28" TextColor="#1A56CC"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Frame>

                <!-- Infos trajet -->
                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label Text="{Binding TimeLabel}"
                           FontFamily="OpenSansSemibold" FontSize="14"
                           FontAttributes="Bold" TextColor="#0D1624">
                        <Label.Triggers>
                            <!-- Barré si annulée -->
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Status}"
                                         Value="Cancelled">
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                <Setter Property="TextColor" Value="#7A879A"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <!-- Route -->
                    <HorizontalStackLayout Spacing="5">
                        <Ellipse WidthRequest="7" HeightRequest="7"
                                 Fill="#1A56CC" VerticalOptions="Center"/>
                        <Label Text="{Binding Route.FromLabel}"
                               FontSize="12" TextColor="#3D4A5C"/>
                        <Label Text="&#xE90F;" FontFamily="FluentRegularIcons"
                               FontSize="12" TextColor="#8A95A8"/>
                        <Ellipse WidthRequest="7" HeightRequest="7"
                                 Fill="#E24B4A" VerticalOptions="Center"/>
                        <Label Text="{Binding Route.ToLabel}"
                               FontSize="12" TextColor="#3D4A5C"/>
                    </HorizontalStackLayout>
                    <!-- Passagers badge -->
                    <Frame Padding="7,3" CornerRadius="10"
                           BackgroundColor="#E8F0FE" BorderColor="Transparent"
                           HorizontalOptions="Start" HasShadow="False">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="&#xF3D8;" FontFamily="FluentRegularIcons"
                                   FontSize="11" TextColor="#1A56CC"/>
                            <Label Text="{Binding PassengerLabel}"
                                   FontSize="11" FontAttributes="Bold" TextColor="#1A56CC"/>
                        </HorizontalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Statut + prix -->
                <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                    <!-- Badge statut — couleur gérée par ApplyState (code-behind) -->
                    <Frame x:Name="StatusBadgeFrame"
                           Padding="7,3" CornerRadius="10" HorizontalOptions="End"
                           BorderColor="Transparent" HasShadow="False">
                        <Label x:Name="StatusLabel"
                               FontFamily="OpenSansSemibold" FontSize="11"
                               FontAttributes="Bold"/>
                    </Frame>
                    <Label Text="{Binding Price, StringFormat='{0:F0} CAD'}"
                           FontFamily="OpenSansSemibold" FontSize="14"
                           FontAttributes="Bold" TextColor="#1A56CC"
                           HorizontalTextAlignment="End"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ── Barre de progression (InProgress) ── -->
            <Grid x:Name="ProgressBar" IsVisible="False"
                  Padding="12,0,12,10" HeightRequest="16">
                <BoxView CornerRadius="3" BackgroundColor="#EEF0F5"
                         HorizontalOptions="Fill" HeightRequest="6"
                         VerticalOptions="Center"/>
                <BoxView CornerRadius="3" HeightRequest="6"
                         VerticalOptions="Center" HorizontalOptions="Start"
                         BackgroundColor="#E24B4A"
                         WidthRequest="{Binding ProgressPercent,
                             Converter={StaticResource RatioToWidth},
                             ConverterParameter='340'}"/>
            </Grid>

            <!-- ── Footer : demandes en attente (WithRequests) ── -->
            <BoxView HeightRequest="1" BackgroundColor="#0D000000"
                     x:Name="FooterSeparator"/>
            <Grid Padding="12,9,12,11" x:Name="FooterActions">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Demandes en attente -->
                <HorizontalStackLayout Grid.Column="0" Spacing="6"
                                       x:Name="PendingBadge" IsVisible="False">
                    <Ellipse WidthRequest="7" HeightRequest="7"
                             Fill="#BA7517" VerticalOptions="Center"/>
                    <Label Text="{Binding PendingRequests, StringFormat='{0} demande(s) en attente'}"
                           FontSize="12" FontAttributes="Bold" TextColor="#BA7517"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Bouton annuler -->
                <Button Grid.Column="1" Text="Annuler"
                        BackgroundColor="Transparent" TextColor="#E24B4A"
                        FontFamily="OpenSansSemibold" FontSize="12"
                        BorderColor="#E24B4A" BorderWidth="1.5"
                        CornerRadius="10" HeightRequest="34"
                        Padding="12,0" x:Name="CancelButton"
                        IsVisible="False"/>
            </Grid>

        </VerticalStackLayout>
    </Frame>
</ContentView>

