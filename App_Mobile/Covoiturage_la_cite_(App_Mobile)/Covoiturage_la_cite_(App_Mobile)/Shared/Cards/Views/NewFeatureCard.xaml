<?xml version="1.0" encoding="utf-8" ?>
<!-- Shared/Cards/Views/NewFeatureCard.xaml -->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Shared.Cards.Views.NewFeatureCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Cards.DisplayModels"
    x:DataType="dm:NewFeatureCardDisplayModel">

    <Frame BackgroundColor="#08316e" CornerRadius="16"
           BorderColor="Transparent" HasShadow="True"
           Padding="0" IsClippedToBounds="True">
        <VerticalStackLayout>
            <VerticalStackLayout Padding="14,16,14,14" Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#xF6E0;" FontFamily="FluentFilledIcons"
                           FontSize="16" TextColor="#FFDAA0"/>
                    <Label Text="{Binding Title}"
                           FontFamily="OpenSansSemibold" FontSize="16"
                           FontAttributes="Bold" TextColor="White"/>
                </HorizontalStackLayout>
                <Label Text="{Binding Description}"
                       FontSize="13" TextColor="#CCE0FF"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" BackgroundColor="#20FFFFFF"/>
            <Grid Padding="12,10,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <BoxView Grid.Column="0"/>
                <Button Grid.Column="1"
                        Text="{Binding CtaLabel}"
                        BackgroundColor="Transparent"
                        TextColor="#90C8FF"
                        FontFamily="OpenSansSemibold" FontSize="13"
                        FontAttributes="Bold"
                        BorderColor="#40FFFFFF"
                        CornerRadius="10" HeightRequest="38"
                        Padding="14,0"
                        x:Name="CtaButton"/>
            </Grid>
        </VerticalStackLayout>
    </Frame>
</ContentView>

