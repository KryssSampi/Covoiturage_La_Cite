<?xml version="1.0" encoding="utf-8" ?>
<!-- Shared/Cards/Views/NotificationCard.xaml -->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.Shared.Cards.Views.NotificationCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Cards.DisplayModels"
    x:DataType="dm:NotificationCardDisplayModel">

    <Frame BackgroundColor="White" CornerRadius="16" BorderColor="#12000000"
           HasShadow="True" Padding="0" IsClippedToBounds="True">
        <VerticalStackLayout>

            <!-- Ligne principale -->
            <Grid Padding="12,12,12,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Frame Grid.Column="0" WidthRequest="44" HeightRequest="44"
                       CornerRadius="22" Padding="0" BorderColor="Transparent"
                       BackgroundColor="{Binding Avatar.BackgroundHex}">
                    <Label Text="{Binding Avatar.Initials}"
                           FontFamily="OpenSansSemibold" FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{Binding Avatar.ForegroundHex}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Frame>

                <!-- Nom + message + pill type -->
                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label Text="{Binding SenderName}"
                           FontFamily="OpenSansSemibold" FontSize="14"
                           FontAttributes="Bold" TextColor="#0D1624"/>
                    <Label Text="{Binding Message}"
                           FontSize="12.5" TextColor="#3D4A5C"
                           LineBreakMode="WordWrap"/>
                    <!-- Pill type -->
                    <Frame Padding="7,3" CornerRadius="10"
                           BorderColor="Transparent" HorizontalOptions="Start"
                           HasShadow="False" Margin="0,4,0,0">
                        <Label x:Name="TypeLabel"
                               FontFamily="OpenSansSemibold" FontSize="11"
                               FontAttributes="Bold"/>
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="NewRequest">
                                <Setter Property="BackgroundColor" Value="#E8F0FE"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Confirmed">
                                <Setter Property="BackgroundColor" Value="#E1F5EE"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Reminder">
                                <Setter Property="BackgroundColor" Value="#FAEEDA"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Info">
                                <Setter Property="BackgroundColor" Value="#E8F0FE"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Cancelled">
                                <Setter Property="BackgroundColor" Value="#FCEBEB"/>
                            </DataTrigger>
                        </Frame.Triggers>
                    </Frame>
                </VerticalStackLayout>

                <!-- Heure -->
                <Label Grid.Column="2"
                       Text="{Binding TimeLabel}"
                       FontSize="11" TextColor="#7A879A"
                       VerticalOptions="Start"/>
            </Grid>

            <!-- Footer : route + actions -->
            <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
            <Grid Padding="12,8,12,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Route mini -->
                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                    <Ellipse WidthRequest="7" HeightRequest="7"
                             Fill="#1A56CC" VerticalOptions="Center"/>
                    <Label Text="{Binding Route.FromLabel}"
                           FontSize="12" TextColor="#3D4A5C"/>
                    <BoxView WidthRequest="20" HeightRequest="1.5"
                             BackgroundColor="#D8DBE5" VerticalOptions="Center"/>
                    <Ellipse WidthRequest="7" HeightRequest="7"
                             Fill="#E24B4A" VerticalOptions="Center"/>
                    <Label Text="{Binding Route.ToLabel}"
                           FontSize="12" TextColor="#3D4A5C"/>
                </HorizontalStackLayout>

                <!-- Refuser (NewRequest) -->
                <Button Grid.Column="1" x:Name="DeclineButton"
                        Text="Refuser"
                        BackgroundColor="#EEF0F5" TextColor="#545D6E"
                        FontFamily="OpenSansSemibold" FontSize="12"
                        CornerRadius="8" HeightRequest="34" Padding="10,0"
                        IsVisible="{Binding HasDeclineAction}"/>

                <!-- Accepter (NewRequest) ou Voir -->
                <Button Grid.Column="2"
                        BackgroundColor="#1A56CC" TextColor="White"
                        FontFamily="OpenSansSemibold" FontSize="12"
                        CornerRadius="8" HeightRequest="34" Padding="12,0"
                        x:Name="PrimaryActionButton">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding HasAcceptAction}" Value="True">
                            <Setter Property="Text" Value="Accepter"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding HasAcceptAction}" Value="False">
                            <Setter Property="Text" Value="Voir →"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </VerticalStackLayout>
    </Frame>
</ContentView>
