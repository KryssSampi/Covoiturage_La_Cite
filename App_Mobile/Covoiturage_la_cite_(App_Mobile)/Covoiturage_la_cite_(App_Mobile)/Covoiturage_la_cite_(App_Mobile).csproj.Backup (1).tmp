	<ItemGroup>
	  <Compile Update="App\Mobilepages\favorispage\view\FavorisPage.xaml.cs">
	    <DependentUpon>FavorisPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="App\Mobilepages\homepage\view\HomePage.xaml.cs">
