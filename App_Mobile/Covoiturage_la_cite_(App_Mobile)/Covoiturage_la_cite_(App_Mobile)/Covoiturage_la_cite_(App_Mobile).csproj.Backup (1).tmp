	<ItemGroup>
	  <MauiXaml Update="App\App.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="App\Mobilepages\plannerpage\view\PlannerPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="App\Mobilepages\statpage\view\StatPage.xaml">
