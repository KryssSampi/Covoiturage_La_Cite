<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Covoiturage_la_cite__App_Mobile_</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Covoiturage_la_cite_(App_Mobile)</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.covoiturage_la_cite_app_mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="App_Mobile\**" />
	  <Compile Remove="App_Mobile\**" />
	  <EmbeddedResource Remove="App_Mobile\**" />
	  <MauiCss Remove="App_Mobile\**" />
	  <MauiXaml Remove="App_Mobile\**" />
	  <None Remove="App_Mobile\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="App\Mobile.pages\homepage\DisplayControler\" />
	  <Folder Include="App\Mobile.pages\homepage\DisplayConverters\" />
	  <Folder Include="App\Mobile.pages\homepage\DisplayModels\" />
	  <Folder Include="App\Mobile.pages\homepage\converter\" />
	  <Folder Include="App\Mobile.pages\homepage\styles\" />
	  <Folder Include="App\Pc.pages\page\converter\" />
	  <Folder Include="App\Pc.pages\page\DisplayControler\" />
	  <Folder Include="App\Pc.pages\page\DisplayConverters\" />
	  <Folder Include="App\Pc.pages\page\DisplayModels\" />
	  <Folder Include="App\Pc.pages\page\styles\" />
	  <Folder Include="App\Pc.pages\page\view\" />
	  <Folder Include="Core\Models\" />
	  <Folder Include="Core\DTOs\" />
	  <Folder Include="Core\Enums\" />
	  <Folder Include="Core\Constants\" />
	  <Folder Include="Core\Interfaces\" />
	  <Folder Include="Core\Context\" />
	  <Folder Include="Core\config\" />
	  <Folder Include="Core\Viewmodels\" />
	  <Folder Include="Core\State\" />
	  <Folder Include="Data\db\" />
	  <Folder Include="Data\Migrations\" />
	  <Folder Include="Data\log\" />
	  <Folder Include="Features\shell\context\" />
	  <Folder Include="Features\shell\converter\" />
	  <Folder Include="Features\shell\DisplayControler\" />
	  <Folder Include="Features\shell\DisplayConverters\" />
	  <Folder Include="Features\shell\DisplayModels\" />
	  <Folder Include="Features\shell\styles\" />
	  <Folder Include="Features\shell\utilis\" />
	  <Folder Include="Features\shell\views\components\" />
	  <Folder Include="Features\shell\views\ui\" />
	  <Folder Include="Features\feature\DisplayConverters\" />
	  <Folder Include="Features\feature\context\" />
	  <Folder Include="Features\feature\converter\" />
	  <Folder Include="Features\feature\styles\" />
	  <Folder Include="Features\feature\utilis\" />
	  <Folder Include="Features\feature\DisplayModels\" />
	  <Folder Include="Features\feature\DisplayControler\" />
	  <Folder Include="Features\feature\views\components\driver\" />
	  <Folder Include="Features\feature\views\components\passenger\" />
	  <Folder Include="Features\feature\views\components\shared\" />
	  <Folder Include="Features\feature\views\ui\" />
	  <Folder Include="Services\api\" />
	  <Folder Include="Services\logger\" />
	  <Folder Include="Services\map\" />
	  <Folder Include="Services\storage\" />
	  <Folder Include="Shared\Helpers\" />
	  <Folder Include="Shared\Converters\" />
	  <Folder Include="Shared\Controls\" />
	  <Folder Include="Shared\Behaviors\" />
	  <Folder Include="Shared\Components\" />
	  <Folder Include="Shared\UI\" />
	  <Folder Include="Shared\Styles\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="App\Mobile.pages\homepage\view\HomePage.xaml.cs">
	    <DependentUpon>HomePage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="App\App.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="App\Mobile.pages\homepage\view\HomePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
