<?xml version="1.0" encoding="utf-8" ?>
<!--
  App/Mobilepages/brouillonspage/view/BrouillonsPage.xaml
  Brouillons de trajets — Shell detail, conducteurs uniquement.
  Tap sur une carte → CreateTripPage pré-remplie.
-->
<ContentPage
    x:Class="Covoiturage_la_cite__App_Mobile_.App.Mobilepages.brouillonspage.view.BrouillonsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:list="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.ItemList.Views;assembly=Covoiturage_la_cite_(App_Mobile)"
    xmlns:bcomp="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.brouillons.Views.Components;assembly=Covoiturage_la_cite_(App_Mobile)"
    xmlns:bdm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.brouillons.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    Title="Brouillons"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F5FA">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="White" Padding="16,14,16,12"
              ColumnDefinitions="Auto,*,Auto">
            <Grid.Shadow>
                <Shadow Brush="#0D000000" Offset="0,2" Radius="6" Opacity="1"/>
            </Grid.Shadow>
            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="22" TextColor="#1A56CC"
                    BackgroundColor="Transparent"
                    Padding="0" WidthRequest="36"
                    Command="{Binding GoBackCommand}"/>
            <Label Grid.Column="1"
                   Text="Mes brouillons"
                   FontFamily="OpenSansSemibold" FontSize="18"
                   TextColor="#0D1624" FontAttributes="Bold"
                   VerticalOptions="Center" Margin="8,0,0,0"/>
            <!-- Nouveau brouillon -->
            <Border Grid.Column="2" BackgroundColor="#EEF3FB"
                    Padding="10,6" StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNewDraftTapped"/>
                </Border.GestureRecognizers>
                <Label Text="+ Nouveau" FontFamily="OpenSansSemibold"
                       FontSize="12" TextColor="#1A56CC"/>
            </Border>
        </Grid>

        <!-- Liste -->
        <list:ItemListView Grid.Row="1" x:Name="BrouillonsList">
            <list:ItemListView.ItemTemplate>
                <DataTemplate x:DataType="bdm:BrouillonCardDisplayModel">
                    <bcomp:BrouillonCard>
                        <bcomp:BrouillonCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBrouillonCardTapped"/>
                        </bcomp:BrouillonCard.GestureRecognizers>
                    </bcomp:BrouillonCard>
                </DataTemplate>
            </list:ItemListView.ItemTemplate>
        </list:ItemListView>

    </Grid>
</ContentPage>
