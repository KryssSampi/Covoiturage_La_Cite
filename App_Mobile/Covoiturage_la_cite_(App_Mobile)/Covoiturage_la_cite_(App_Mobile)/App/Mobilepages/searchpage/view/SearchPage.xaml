<?xml version="1.0" encoding="utf-8" ?>
<!--
  App/Mobilepages/searchpage/view/SearchPage.xaml
  ════════════════════════════════════════════════════════════════════════
  Page de recherche — route Shell "search" (hors wrapper MainView).

  Zones :
  ┌────────────────────────────┐
  │  INPUT ZONE (sticky)       │  ← chip "Votre position" ou entry From
  │                            │     entry To + bouton 🔍 / ✓
  ├────────────────────────────┤
  │  SUGGESTIONS               │  ← focus actif uniquement
  ├────────────────────────────┤
  │  MAP WEBVIEW               │  ← conducteur + Results uniquement
  ├────────────────────────────┤
  │  LISTING ZONE              │  ← Loader / NoConn / NoResult / Results
  └────────────────────────────┘
-->
<ContentPage
    x:Class="Covoiturage_la_cite__App_Mobile_.App.Mobilepages.searchpage.view.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cards="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Cards.Views"
    xmlns:dm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.search.DisplayModels"
    xmlns:conv="clr-namespace:Covoiturage_la_cite__App_Mobile_.Shared.Converters"
    Title="Rechercher"
    BackgroundColor="#F2F5FA"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:InverseBoolConverter           x:Key="InverseBool"/>
        <conv:BoolToVisibilityConverter      x:Key="BoolToVis"/>
        <conv:StringNotEmptyToBoolConverter  x:Key="StringNotEmpty"/>
    </ContentPage.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- INPUT ZONE -->
            <RowDefinition Height="*"/>     <!-- SUGGESTIONS + MAP + LISTING -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 : INPUT ZONE
        ══════════════════════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="White" Spacing="0">

            <!-- ── Bouton Back ── -->
            <Grid Padding="8,8,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="Transparent"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="24"
                           TextColor="#1A56CC"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <Label Grid.Column="1"
                       Text="Rechercher"
                       FontSize="18"
                       FontFamily="OpenSansSemibold"
                       TextColor="#1A1A2E"
                       VerticalOptions="Center"
                       Margin="8,0,0,0"/>
            </Grid>

            <Grid Padding="16,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Colonne champs ── -->
                <VerticalStackLayout Grid.Column="0" Spacing="0">

                    <!-- FROM chip "Votre position" (UseCurrentLocation = true) -->
                    <Frame x:Name="FromChipFrame"
                           CornerRadius="12" Padding="0"
                           BackgroundColor="#F8F9FC"
                           BorderColor="#D8DBE5"
                           HasShadow="False"
                           IsVisible="{Binding ShowFromLocationChip}"
                           Margin="0,0,8,0">
                        <Grid HeightRequest="50" Padding="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" Padding="0"
                                   BackgroundColor="Transparent"
                                   BorderColor="Transparent" HasShadow="False">
                                <Ellipse WidthRequest="10" HeightRequest="10"
                                         Fill="#1A56CC"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                            </Frame>

                            <Border Grid.Column="1"
                                    BackgroundColor="#E8F0FE"
                                    StrokeThickness="0"
                                    Padding="10,6"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999"/>
                                </Border.StrokeShape>
                                <Label Text="Votre position"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13"
                                       TextColor="#1A56CC"/>
                            </Border>

                            <!-- Croix — retire le chip -->
                            <Label Grid.Column="2"
                                   Text="&#xE8BB;" FontFamily="FluentRegularIcons"
                                   FontSize="16" TextColor="#8A95A8"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearCurrentLocationCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Frame>

                    <!-- FROM entrée normale -->
                    <Frame x:Name="FromFrame"
                           CornerRadius="12" Padding="0"
                           BackgroundColor="#F8F9FC"
                           HasShadow="False"
                           IsVisible="{Binding ShowFromEntry}"
                           Margin="0,0,8,0">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsFromFocused}" Value="True">
                                <Setter Property="BorderColor" Value="#1A56CC"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsFromFocused}" Value="False">
                                <Setter Property="BorderColor" Value="#D8DBE5"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Grid HeightRequest="50" Padding="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" Padding="0"
                                   BackgroundColor="Transparent"
                                   BorderColor="Transparent" HasShadow="False">
                                <Ellipse WidthRequest="10" HeightRequest="10"
                                         Fill="#1A56CC"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                            </Frame>

                            <Entry Grid.Column="1"
                                   x:Name="FromEntry"
                                   Placeholder="Point de départ"
                                   PlaceholderColor="#8A95A8"
                                   TextColor="#0D1624"
                                   FontFamily="OpenSansRegular" FontSize="14"
                                   BackgroundColor="Transparent"
                                   ReturnType="Next"
                                   Text="{Binding FromText, Mode=TwoWay}"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="2"
                                   Text="&#xE8BB;" FontFamily="FluentRegularIcons"
                                   FontSize="16" TextColor="#8A95A8"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   IsVisible="{Binding FromHasValue}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearFromCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FocusFromCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Frame>

                    <!-- Trait pointillé + swap (hors-focus) -->
                    <Grid HeightRequest="24" Margin="0,0,8,0"
                          IsVisible="{Binding IsFocused, Converter={StaticResource InverseBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <BoxView Grid.Column="0"
                                 WidthRequest="1.5" HeightRequest="24"
                                 BackgroundColor="#D8DBE5"
                                 HorizontalOptions="Center"/>

                        <Frame Grid.Column="2"
                               WidthRequest="28" HeightRequest="28"
                               CornerRadius="14" Padding="0"
                               BackgroundColor="#EEF0F5"
                               BorderColor="Transparent"
                               HasShadow="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label Text="&#xE8D6;" FontFamily="FluentRegularIcons"
                                   FontSize="15" TextColor="#545D6E"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SwapCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>
                    </Grid>

                    <!-- TO -->
                    <Frame x:Name="ToFrame"
                           CornerRadius="12" Padding="0"
                           BackgroundColor="#F8F9FC"
                           HasShadow="False"
                           IsVisible="{Binding ShowToEntry}"
                           Margin="0,0,8,0">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsToFocused}" Value="True">
                                <Setter Property="BorderColor" Value="#1A56CC"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsToFocused}" Value="False">
                                <Setter Property="BorderColor" Value="#D8DBE5"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Grid HeightRequest="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" Padding="0"
                                   BackgroundColor="Transparent"
                                   BorderColor="Transparent" HasShadow="False">
                                <Ellipse WidthRequest="10" HeightRequest="10"
                                         Fill="#E24B4A"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                            </Frame>

                            <Entry Grid.Column="1"
                                   x:Name="ToEntry"
                                   Placeholder="Destination"
                                   PlaceholderColor="#8A95A8"
                                   TextColor="#0D1624"
                                   FontFamily="OpenSansRegular" FontSize="14"
                                   BackgroundColor="Transparent"
                                   ReturnType="Search"
                                   Text="{Binding ToText, Mode=TwoWay}"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="2"
                                   Text="&#xE8BB;" FontFamily="FluentRegularIcons"
                                   FontSize="16" TextColor="#8A95A8"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   IsVisible="{Binding ToHasValue}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearToCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FocusToCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Frame>

                </VerticalStackLayout>

                <!-- ── Bouton droit ── -->
                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <!-- 🔍 SEARCH hors-focus + canSearch -->
                    <Frame WidthRequest="52" HeightRequest="52"
                           CornerRadius="14" Padding="0"
                           BackgroundColor="#1A56CC"
                           BorderColor="Transparent"
                           HasShadow="True"
                           IsVisible="{Binding ShowSearchButton}">
                        <Label Text="&#xF1EB;" FontFamily="FluentFilledIcons"
                               FontSize="24" TextColor="White"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SearchCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>

                    <!-- ✓ CONFIRM focus -->
                    <Frame WidthRequest="52" HeightRequest="52"
                           CornerRadius="14" Padding="0"
                           BackgroundColor="#0F6E56"
                           BorderColor="Transparent"
                           HasShadow="True"
                           IsVisible="{Binding ShowConfirmButton}">
                        <Label Text="&#xF297;" FontFamily="FluentFilledIcons"
                               FontSize="24" TextColor="White"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConfirmInputCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>

                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
        </VerticalStackLayout>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 : SUGGESTIONS + MAP + LISTING
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ── SUGGESTIONS ── -->
            <VerticalStackLayout BackgroundColor="White"
                                 IsVisible="{Binding ShowSuggestions}"
                                 VerticalOptions="Fill">

                <Label Padding="16,12,16,6"
                       Text="SUGGESTIONS"
                       FontFamily="OpenSansSemibold" FontSize="11"
                       FontAttributes="Bold" TextColor="#7A879A"
                       CharacterSpacing="0.8"/>

                <CollectionView ItemsSource="{Binding Suggestions}"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dm:LocationSuggestionDisplayModel">
                            <Grid Padding="16,10,16,10" ColumnSpacing="12"
                                  BackgroundColor="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Column="0"
                                       WidthRequest="38" HeightRequest="38"
                                       CornerRadius="10" Padding="0"
                                       BackgroundColor="{Binding IconBgHex}"
                                       BorderColor="Transparent" HasShadow="False">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="FluentFilledIcons"
                                           FontSize="18"
                                           TextColor="{Binding IconFgHex}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Label}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="#0D1624"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SubLabel}"
                                           FontSize="12" TextColor="#7A879A"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <!-- Badge favori ⭐ -->
                                <Frame Grid.Column="2" Padding="5,3"
                                       CornerRadius="8" HasShadow="False"
                                       BorderColor="Transparent"
                                       BackgroundColor="#FEF3C7"
                                       IsVisible="{Binding Type,
                                           Converter={StaticResource IsFavoriteConverter}}">
                                    <Label Text="&#xF6E0;" FontFamily="FluentFilledIcons"
                                           FontSize="12" TextColor="#92400E"/>
                                </Frame>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectSuggestionCommand,
                                            Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ── LISTING + MAP (hors-focus) ── -->
            <Grid IsVisible="{Binding ShowListing}"
                  BackgroundColor="#F2F5FA"
                  RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- WebView conducteur -->
                    <RowDefinition Height="*"/>     <!-- États listing -->
                </Grid.RowDefinitions>

                <!-- WebView Leaflet — conducteur uniquement, au-dessus de la listing zone -->
                <WebView x:Name="MapWebView"
                         Grid.Row="0"
                         HeightRequest="220"
                         IsVisible="{Binding ShowMapWebView}"
                         Margin="0,0,0,0"/>

                <VerticalStackLayout Grid.Row="1">

                    <!-- LOADER -->
                    <VerticalStackLayout IsVisible="{Binding ShowLoader}"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="20,60" Spacing="16">
                        <ActivityIndicator IsRunning="{Binding ShowLoader}"
                                           Color="#1A56CC"
                                           WidthRequest="44" HeightRequest="44"/>
                        <Label Text="Recherche en cours…"
                               FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#3D4A5C"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- NO CONNECTION -->
                    <VerticalStackLayout IsVisible="{Binding ShowNoConnection}"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="32,60" Spacing="14">
                        <Frame WidthRequest="72" HeightRequest="72" CornerRadius="36"
                               BackgroundColor="#FCEBEB" BorderColor="#FCEBEB"
                               HasShadow="False" HorizontalOptions="Center">
                            <Label Text="&#xF4CB;" FontFamily="FluentRegularIcons"
                                   FontSize="36" TextColor="#E24B4A"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <Label Text="Pas de connexion"
                               FontFamily="OpenSansSemibold" FontSize="18"
                               FontAttributes="Bold" TextColor="#0D1624"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Vérifiez votre connexion internet et réessayez."
                               FontSize="13" TextColor="#7A879A"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                        <Button Text="Réessayer"
                                BackgroundColor="#1A56CC" TextColor="White"
                                FontFamily="OpenSansSemibold" FontSize="14"
                                CornerRadius="14" HeightRequest="50"
                                Padding="24,0" HorizontalOptions="Center"
                                Command="{Binding RetryCommand}"/>
                    </VerticalStackLayout>

                    <!-- NO RESULT -->
                    <VerticalStackLayout IsVisible="{Binding ShowNoResult}"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="32,60" Spacing="14">
                        <Frame WidthRequest="72" HeightRequest="72" CornerRadius="36"
                               BackgroundColor="#EEF0F5" BorderColor="#D8DBE5"
                               HasShadow="False"
                               HorizontalOptions="Center">
                            <Label Text="&#xF51C;" FontFamily="FluentRegularIcons"
                                   FontSize="36" TextColor="#8A95A8"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <Label Text="Aucun résultat"
                               FontFamily="OpenSansSemibold" FontSize="18"
                               FontAttributes="Bold" TextColor="#0D1624"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Aucun trajet trouvé. Essayez d'autres adresses."
                               FontSize="13" TextColor="#7A879A"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- RESULTS -->
                    <ScrollView IsVisible="{Binding ShowResults}"
                                VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Padding="16,12,16,24" Spacing="12">
                            <Label FontSize="12" TextColor="#7A879A" Margin="0,0,0,4">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Results.Count}"/>
                                        <Span Text=" trajet(s) trouvé(s)"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <CollectionView ItemsSource="{Binding Results}"
                                            SelectionMode="None"
                                            x:Name="ResultsList">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Grid>

            <!-- Tap hors champs → ferme le focus -->
            <Grid IsVisible="{Binding IsFocused}"
                  BackgroundColor="Transparent"
                  InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClearFocusCommand}"/>
                </Grid.GestureRecognizers>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
