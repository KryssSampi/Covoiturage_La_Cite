<?xml version="1.0" encoding="utf-8" ?>
<!--
  App/Mobilepages/favorispage/view/FavorisPage.xaml
  Page Favoris (onglet MainView).
  3 sections : Lieux | Conducteurs | Alertes
  + Popup centré "Ajouter un lieu"
  + Bottom Sheet "Ajouter un conducteur"
-->
<ContentView
    x:Class="Covoiturage_la_cite__App_Mobile_.App.Mobilepages.favorispage.view.FavorisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:favcomp="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.favoris.Views.Components;assembly=Covoiturage_la_cite_(App_Mobile)"
    BackgroundColor="#F2F5FA">

    <!-- Couche racine : contenu + overlays empilés -->
    <Grid VerticalOptions="Fill">

        <!-- ═══════════════════════════════════════════════
             CONTENU PRINCIPAL
        ═══════════════════════════════════════════════ -->
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <!-- ── LIEUX ───────────────────────────────────────── -->
                <Grid Padding="16,18,16,10" ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <Frame WidthRequest="32" HeightRequest="32" CornerRadius="8"
                               Padding="0" BackgroundColor="#EEF3FB"
                               BorderColor="Transparent" HasShadow="False">
                            <Label Text="📍" FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <Label Text="Lieux favoris" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#0D1624" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="PlacesCountLabel"
                               FontFamily="OpenSansSemibold" FontSize="11"
                               TextColor="#7A879A" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#EEF3FB" Padding="11,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="99"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddPlaceTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="+" FontSize="13" TextColor="#1A56CC" FontAttributes="Bold"/>
                            <Label Text="Ajouter" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#1A56CC"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <VerticalStackLayout x:Name="PlacesStack" Spacing="0"/>

                <!-- ── CONDUCTEURS FAVORIS ─────────────────────────── -->
                <Grid Padding="16,14,16,10" ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <Frame WidthRequest="32" HeightRequest="32" CornerRadius="8"
                               Padding="0" BackgroundColor="#E1F5EE"
                               BorderColor="Transparent" HasShadow="False">
                            <Label Text="👥" FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <Label Text="Conducteurs favoris" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#0D1624" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="PersonsCountLabel"
                               FontFamily="OpenSansSemibold" FontSize="11"
                               TextColor="#7A879A" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#E1F5EE" Padding="11,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="99"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddPersonTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="+" FontSize="13" TextColor="#0F6E56" FontAttributes="Bold"/>
                            <Label Text="Ajouter" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#0F6E56"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <VerticalStackLayout x:Name="PersonsStack" Spacing="0"/>

                <!-- ── ALERTES TRAJETS ─────────────────────────────── -->
                <Grid Padding="16,14,16,10" ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <Frame WidthRequest="32" HeightRequest="32" CornerRadius="8"
                               Padding="0" BackgroundColor="#FAEEDA"
                               BorderColor="Transparent" HasShadow="False">
                            <Label Text="🔔" FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <Label Text="Alertes de trajets" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#0D1624" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="AlertsCountLabel"
                               FontFamily="OpenSansSemibold" FontSize="11"
                               TextColor="#7A879A" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <!-- Alertes se créent depuis la recherche -->
                    <Border Grid.Column="1" BackgroundColor="#FAEEDA" Padding="11,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="99"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddAlertTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="🔍" FontSize="11"/>
                            <Label Text="Rechercher" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#BA7517"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Note info alertes -->
                <Border Margin="12,0,12,8" Padding="12" StrokeThickness="1"
                        BackgroundColor="#FAEEDA">
                    <Border.Stroke><SolidColorBrush Color="#BA7517"/></Border.Stroke>
                    <Border.Opacity>0.2</Border.Opacity>
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="ℹ️" FontSize="12" VerticalOptions="Start"/>
                        <Label Text="Les alertes se créent depuis la page de recherche. Si aucun trajet n'est disponible, sauvegardez votre recherche en alerte."
                               FontSize="12" TextColor="#BA7517" LineBreakMode="WordWrap" HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="AlertsStack" Spacing="0"/>
                <BoxView HeightRequest="24"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════════
             OVERLAY — BACKDROP (partagé popup + sheet)
        ═══════════════════════════════════════════════ -->
        <BoxView x:Name="Backdrop"
                 BackgroundColor="#80000000"
                 IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ═══════════════════════════════════════════════
             POPUP CENTRÉ — AJOUTER UN LIEU
        ═══════════════════════════════════════════════ -->
        <Border x:Name="LieuPopup"
                BackgroundColor="White"
                StrokeThickness="0"
                Margin="20,0"
                VerticalOptions="Center"
                IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#25000000" Offset="0,8" Radius="28" Opacity="1"/></Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Header popup -->
                <Grid Padding="20,18,20,14" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="📍 Ajouter un lieu favori"
                           FontFamily="OpenSansSemibold" FontSize="15"
                           TextColor="#0D1624" FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Frame Grid.Column="1"
                           WidthRequest="28" HeightRequest="28" CornerRadius="14"
                           Padding="0" BackgroundColor="#EEF0F5"
                           BorderColor="Transparent" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseLieuPopup"/>
                        </Frame.GestureRecognizers>
                        <Label Text="✕" FontSize="12" TextColor="#3D4A5C"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Frame>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>

                <!-- Body popup -->
                <VerticalStackLayout Padding="20,14" Spacing="12">

                    <!-- Barre de recherche adresse -->
                    <Border StrokeThickness="1.5" Padding="12,10">
                        <Border.Stroke><SolidColorBrush x:Name="LieuSearchStroke" Color="#D8DBE5"/></Border.Stroke>
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🔍" FontSize="14" VerticalOptions="Center"/>
                            <Entry x:Name="LieuSearchEntry"
                                   Placeholder="Rechercher une adresse…"
                                   PlaceholderColor="#7A879A"
                                   FontSize="14" TextColor="#0D1624"
                                   BackgroundColor="Transparent"
                                   HorizontalOptions="FillAndExpand"
                                   TextChanged="OnLieuSearchTextChanged"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Note GPS -->
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="⚠️" FontSize="11"/>
                        <Label Text="Sélectionnez parmi les suggestions (coordonnées GPS requises)."
                               FontSize="11" TextColor="#BA7517" LineBreakMode="WordWrap"
                               HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>

                    <!-- Suggestions injectées par code-behind -->
                    <VerticalStackLayout x:Name="SuggestionsContainer" Spacing="0" IsVisible="False">
                        <Border StrokeThickness="1.5" Padding="0">
                            <Border.Stroke><SolidColorBrush Color="#1A56CC"/></Border.Stroke>
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout x:Name="SuggestionsInner" Spacing="0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Champ pseudonyme -->
                    <Label Text="PSEUDONYME DU LIEU"
                           FontFamily="OpenSansSemibold" FontSize="10"
                           TextColor="#7A879A" CharacterSpacing="0.6"/>
                    <Border StrokeThickness="1.5" Padding="12,10">
                        <Border.Stroke><SolidColorBrush Color="#D8DBE5"/></Border.Stroke>
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="✏️" FontSize="14" VerticalOptions="Center"/>
                            <Entry x:Name="PseudoEntry"
                                   Placeholder="Ex : Campus du matin…"
                                   PlaceholderColor="#7A879A"
                                   FontSize="14" TextColor="#0D1624"
                                   BackgroundColor="Transparent"
                                   HorizontalOptions="Fill"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Preset pills -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="PresetPills" Spacing="7"/>
                    </ScrollView>

                </VerticalStackLayout>

                <!-- CTA popup -->
                <BoxView HeightRequest="1" BackgroundColor="#0D000000"/>
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="10" Padding="20,12,20,18">
                    <Border Grid.Column="0" BackgroundColor="#EEF0F5"
                            Padding="0" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseLieuPopup"/>
                        </Border.GestureRecognizers>
                        <Label Text="Annuler" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#3D4A5C"
                               HorizontalTextAlignment="Center" Padding="0,13"/>
                    </Border>
                    <Border Grid.Column="1" x:Name="SaveLieuBtn"
                            BackgroundColor="#A8B4C8"
                            Padding="0" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSaveLieu"/>
                        </Border.GestureRecognizers>
                        <Label Text="Enregistrer" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="White"
                               HorizontalTextAlignment="Center" Padding="0,13"/>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- ═══════════════════════════════════════════════
             BOTTOM SHEET — AJOUTER UN CONDUCTEUR
        ═══════════════════════════════════════════════ -->
        <Border x:Name="PersonSheet"
                BackgroundColor="White"
                StrokeThickness="0"
                VerticalOptions="End"
                HeightRequest="520"
                IsVisible="False"
                TranslationY="520">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#20000000" Offset="0,-4" Radius="20" Opacity="1"/></Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                <!-- Handle -->
                <HorizontalStackLayout Grid.Row="0"
                                       HorizontalOptions="Center"
                                       Padding="0,10,0,4">
                    <BoxView WidthRequest="40" HeightRequest="4"
                             Color="#D8DBE5" CornerRadius="2"/>
                </HorizontalStackLayout>

                <!-- Header sheet -->
                <Grid Grid.Row="1" Padding="20,4,20,12" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="👤 Ajouter un conducteur"
                           FontFamily="OpenSansSemibold" FontSize="16"
                           TextColor="#0D1624" FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Frame Grid.Column="1"
                           WidthRequest="30" HeightRequest="30" CornerRadius="15"
                           Padding="0" BackgroundColor="#EEF0F5"
                           BorderColor="Transparent" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClosePersonSheet"/>
                        </Frame.GestureRecognizers>
                        <Label Text="✕" FontSize="13" TextColor="#3D4A5C"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Frame>
                </Grid>

                <!-- Search bar sheet -->
                <Border Grid.Row="2"
                        Margin="16,0,16,0" Padding="12,10"
                        StrokeThickness="1.5">
                    <Border.Stroke><SolidColorBrush Color="#D8DBE5"/></Border.Stroke>
                    <Border.StrokeShape><RoundRectangle CornerRadius="99"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🔍" FontSize="14" VerticalOptions="Center"/>
                        <Entry x:Name="PersonSearchEntry"
                               Placeholder="Rechercher un conducteur…"
                               PlaceholderColor="#7A879A"
                               FontSize="14" TextColor="#0D1624"
                               BackgroundColor="Transparent"
                               HorizontalOptions="FillAndExpand"
                               TextChanged="OnPersonSearchTextChanged"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Barre sélection (cachée si 0 sélectionnés) -->
                <Grid Grid.Row="2" x:Name="SelCountBar"
                      ColumnDefinitions="*,Auto"
                      BackgroundColor="#E8F0FE"
                      Padding="16,8"
                      Margin="0,56,0,0"
                      IsVisible="False">
                    <Label Grid.Column="0" x:Name="SelCountLabel"
                           Text="0 sélectionné(s)"
                           FontSize="12" FontFamily="OpenSansSemibold"
                           TextColor="#0D3A8C" VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="Tout désélectionner"
                           FontSize="12" FontFamily="OpenSansSemibold"
                           TextColor="#E24B4A" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSelections"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Liste conducteurs (ScrollView) -->
                <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="SheetResultsStack" Spacing="0">

                        <!-- Empty state initial -->
                        <VerticalStackLayout x:Name="SheetEmptyState"
                                             HorizontalOptions="Center"
                                             Padding="20,32"
                                             Spacing="8">
                            <Label Text="👥" FontSize="36"
                                   HorizontalOptions="Center"/>
                            <Label Text="Trouvez un conducteur"
                                   FontFamily="OpenSansSemibold" FontSize="13"
                                   TextColor="#545D6E"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Saisissez un nom pour rechercher parmi les conducteurs de La Cité."
                                   FontSize="12" TextColor="#7A879A"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Résultats injectés par code-behind -->
                        <VerticalStackLayout x:Name="SheetPersonRows" Spacing="0" IsVisible="False"/>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- CTA sheet -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="*,2*" ColumnSpacing="10"
                      Padding="16,14,16,20">
                    <Grid.Shadow><Shadow Brush="#10000000" Offset="0,-2" Radius="6" Opacity="1"/></Grid.Shadow>
                    <Border Grid.Column="0" BackgroundColor="#EEF0F5"
                            Padding="0" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClosePersonSheet"/>
                        </Border.GestureRecognizers>
                        <Label Text="Annuler" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="#3D4A5C"
                               HorizontalTextAlignment="Center" Padding="0,13"/>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="#0F6E56"
                            Padding="0" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSavePersons"/>
                        </Border.GestureRecognizers>
                        <Label Text="Enregistrer" FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="White"
                               HorizontalTextAlignment="Center" Padding="0,13"/>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             TOAST
        ═══════════════════════════════════════════════ -->
        <Border x:Name="ToastView"
                BackgroundColor="#2C3345"
                Padding="18,10"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,80"
                Opacity="0"
                IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="99"/></Border.StrokeShape>
            <HorizontalStackLayout Spacing="7">
                <Label Text="✓" FontSize="13" TextColor="White"/>
                <Label x:Name="ToastLabel" FontSize="13" TextColor="White"
                       FontFamily="OpenSansSemibold"/>
            </HorizontalStackLayout>
        </Border>

    </Grid>
</ContentView>
