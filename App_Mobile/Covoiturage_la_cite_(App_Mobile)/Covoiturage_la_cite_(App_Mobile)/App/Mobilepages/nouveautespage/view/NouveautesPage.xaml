<?xml version="1.0" encoding="utf-8" ?>
<!--
  App/Mobilepages/nouveautespage/view/NouveautesPage.xaml
  Nouveautés / Changelog — Shell detail.
  Grandes cartes avec vidéo YouTube en boucle.
  Pas d'ItemList — CollectionView simple (pas de recherche/filtres).
-->
<ContentPage
    x:Class="Covoiturage_la_cite__App_Mobile_.App.Mobilepages.nouveautespage.view.NouveautesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ncomp="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.nouveautes.Views.Components;assembly=Covoiturage_la_cite_(App_Mobile)"
    xmlns:ndm="clr-namespace:Covoiturage_la_cite__App_Mobile_.Features.nouveautes.DisplayModels;assembly=Covoiturage_la_cite_(App_Mobile)"
    Title="Nouveautés"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F5FA">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="White" Padding="16,14,16,12"
              ColumnDefinitions="Auto,*">
            <Grid.Shadow>
                <Shadow Brush="#0D000000" Offset="0,2" Radius="6" Opacity="1"/>
            </Grid.Shadow>
            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="22" TextColor="#1A56CC"
                    BackgroundColor="Transparent"
                    Padding="0" WidthRequest="36"
                    Command="{Binding GoBackCommand}"/>
            <Label Grid.Column="1"
                   Text="Nouveautés"
                   FontFamily="OpenSansSemibold" FontSize="18"
                   TextColor="#0D1624" FontAttributes="Bold"
                   VerticalOptions="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- Feed grandes cartes -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" x:Name="CardsStack"
                                 Padding="0,8,0,24"/>
        </ScrollView>

    </Grid>
</ContentPage>
