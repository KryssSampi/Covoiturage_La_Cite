<ContentPage x:Class="Covoiturage_la_cite__App_Mobile_.App.Mobilepages.publicprofilepage.view.PublicProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profil public">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Image x:Name="BannerImage" 
                   Source="banner_profile.png" 
                   HeightRequest="150" 
                   HorizontalOptions="Fill" />

            <ContentView x:Name="HeaderCardHost" />

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="BtnStats" Text="Stats" ClassId="stats" Clicked="NavigateToSection" />
                <Button x:Name="BtnReviews" Text="Avis" ClassId="reviews" Clicked="NavigateToSection" />
                <Button x:Name="BtnTrips" Text="Trajets" ClassId="trips" Clicked="NavigateToSection" />
                <Button x:Name="BtnRecurring" Text="Habituels" ClassId="recurring" Clicked="NavigateToSection" />
            </HorizontalStackLayout>

            <ContentView x:Name="SectionContentHost" />

            <Button x:Name="BtnLike" Text="👍 Like" />
            <Button x:Name="BtnFavorite" Text="{Binding FavoriteButtonLabel}" Command="{Binding ToggleFavoriteCommand}" />

            <ActivityIndicator IsVisible="{Binding IsLoading}" Color="Blue" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
